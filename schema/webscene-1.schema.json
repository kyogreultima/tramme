{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 86400
    },
    "size": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "number"
              },
              "default": {
                "type": "number"
              }
            },
            "required": [
              "type",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "string"
              },
              "default": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "type",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "default"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "color"
              },
              "default": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [
              "type",
              "default"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "duration",
    "size",
    "entry",
    "parameters"
  ],
  "additionalProperties": false
}
