{
  "name": "tramme",
  "version": "0.15.1",
  "private": true,
  "type": "module",
  "description": "Motion design engine and editor: JSON document, deterministic rendering, web editor",
  "license": "Apache-2.0",
  "author": "Aziz Chanou",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node apps/editor/build.ts",
    "dev": "node apps/editor/build.ts --dev",
    "dev:personal": "node apps/editor/build.ts --dev --personal",
    "deploy": "node apps/editor/build.ts && wrangler deploy -c apps/worker/wrangler.jsonc",
    "deploy:personal": "node apps/editor/build.ts && wrangler deploy -c apps/worker/wrangler.jsonc --env personal",
    "site": "npm run dev -w apps/site",
    "site:build": "npm run build -w apps/site",
    "site:deploy": "npm run site:build && wrangler deploy -c apps/site/wrangler.jsonc",
    "desktop:dev": "node apps/editor/build.ts && cd apps/desktop && tauri dev",
    "desktop:build": "node apps/editor/build.ts && cd apps/desktop && tauri build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p apps/worker",
    "tramme": "node packages/cli/src/main.ts",
    "edit": "node packages/cli/src/main.ts edit",
    "schema": "node packages/cli/src/main.ts schema",
    "packs:index": "node scripts/packs/index.ts",
    "typefaces:catalogue": "node scripts/typefaces/catalogue.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "lottie-web": "^5.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@preact/signals": "^2.11.3",
    "driver.js": "^1.8.0",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.61.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pdfjs-dist": "^6.4.299",
    "preact": "^10.29.8"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
