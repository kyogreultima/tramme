{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tramme",
  "version": "0.21.0",
  "identifier": "app.tramme.desktop",
  "build": {
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Qualris",
    "copyright": "© 2026 Qualris",
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["tramme"],
        "name": "Tramme project",
        "description": "A Tramme project"
      }
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
