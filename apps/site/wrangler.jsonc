{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The project's site (apps/site): an Astro build with the Cloudflare adapter
  // (landing, platform pages, Starlight docs). Every page is prerendered today and
  // served as static assets; the adapter writes the deployed configuration to
  // dist/client/wrangler.json and .wrangler/deploy/config.json, which `wrangler deploy`
  // follows when run from this folder: pnpm site:deploy (build, then deploy).
  // See docs/deploy.md for the editor Worker.
  "name": "tramme-site",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist/client",
    // Starlight builds a 404.html: served, with a 404 status, on unknown paths
    "not_found_handling": "404-page"
  },
  // branch builds (pnpm exec wrangler preview): no vars nor bindings to tell apart from production
  "previews": {}
  // To serve the site from your own domain (a zone on this Cloudflare account),
  // add routes and deploy again. Keep them in step with the editor's addresses
  // (apps/worker/wrangler.jsonc): the site at the root, the editor on a subdomain.
  // "routes": [
  //   { "pattern": "tramme.example.com", "custom_domain": true },
  //   { "pattern": "www.tramme.example.com", "custom_domain": true }
  // ]
}
