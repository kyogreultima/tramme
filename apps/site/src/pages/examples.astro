---
// The gallery: every example of the repository, each across the page with its
// video, and a way into its folder
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHead from '../components/PageHead.astro';
import ExampleTile from '../components/ExampleTile.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import { IDS } from '../lib/examples';
---

<Base title="Made with Tramme, the examples" description="Films made with Tramme, each one in the repository, ready to open and take apart.">
  <Nav />
  <main>
    <PageHead title="Made with Tramme." lead="Every example is a project of the repository: open it in the app, change what you like, export it." />
    <section class="wrap list">
      {IDS.map((id) => <ExampleTile id={id} link />)}
    </section>
    <Closing />
  </main>
  <Footer />
</Base>

<style>
  .list { display: grid; gap: clamp(40px, 5vw, 72px); margin-top: clamp(40px, 5vw, 64px); }
</style>
