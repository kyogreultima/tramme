---
// Everything the app does, section by section: the studio, the atelier, the
// assistant, the packs, the way animation is made, the export. The landing
// page shows each in a line and leads here (components/Pillars.astro).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHead from '../components/PageHead.astro';
import Studio from '../components/Studio.astro';
import Editor from '../components/Editor.astro';
import Assistant from '../components/Assistant.astro';
import Packs from '../components/Packs.astro';
import Inside from '../components/Inside.astro';
import Render from '../components/Render.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Features, what Tramme does" description="The studio, the atelier, the assistant, the packs and the export: everything Tramme does, one film all the way.">
  <Nav />
  <main>
    <PageHead title="Everything the app does." lead="Direct the film in the studio, refine it in the atelier, let the assistant work with your tools, add what comes up often, export what you see." />
    <Studio />
    <Editor />
    <Assistant />
    <Packs />
    <Inside />
    <Render />
    <Closing />
  </main>
  <Footer />
</Base>
