---
// The community's public projects, every one in a grid, most recent first.
// Read through lib/gallery.ts, which today returns the repository's examples
// and later the gallery API. (With the API, set `prerender = false` here.)
import Page from '../../components/Page.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Closing from '../../components/Closing.astro';
import { listProjects } from '../../lib/gallery';
import { localeOf, localePaths, t } from '../../lib/i18n';

export const getStaticPaths = localePaths;

const locale = localeOf(Astro.url.pathname);
const projects = await listProjects({ sort: 'recent' });
---

<Page title={t(locale, 'explore.metaTitle')} description={t(locale, 'explore.metaDescription')}>
  <PageHead title={t(locale, 'explore.title')} lead={t(locale, 'explore.lead')} />
  <section class="wrap list">
    {/* paused until Tramme's own visuals are good enough: reopen by restoring this block
    {projects.length > 0
      ? <div class="grid gallery">{projects.map((project) => <ProjectCard project={project} locale={locale} />)}</div>
      : <p class="none">{t(locale, 'card.empty')}</p>}
    */}
    <p class="none">{t(locale, 'card.empty')}</p>
  </section>
  <Closing locale={locale} />
</Page>

<style>
  .list { margin-top: clamp(40px, 5vw, 64px); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; }
  .none { text-align: center; color: var(--ink-3); }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
