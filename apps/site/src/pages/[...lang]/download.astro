---
// The app, every system's installers side by side, from the latest
// release on GitHub (lib/download.ts): where the download button leads when
// the visitor's system cannot be told (Platform.astro), and where another
// system's app is chosen. The visitor's system, when known, comes first.
import DownloadSimple from '@phosphor-icons/core/assets/regular/download-simple.svg';
import ArrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg';
import Page from '../../components/Page.astro';
import PageHead from '../../components/PageHead.astro';
import SystemIcon from '../../components/SystemIcon.astro';
import { OFFERED_SYSTEMS, SYSTEMS, WITHHELD, systemsLine, type Os } from '../../../../desktop/downloads.ts';
import { APP, REPO } from '../../lib/links';
import { localeOf, localePaths, pick, type Localised } from '../../lib/i18n';

export const getStaticPaths = localePaths;

const locale = localeOf(Astro.url.pathname);

const release = __RELEASE__;
const RELEASES = `${REPO}/releases`;

// the first launch of an app that is not signed by a known publisher yet
const FIRST: Localised<Record<Os, string>> = {
  en: {
    windows: 'Windows may warn about an unknown publisher the first time: choose More info, then Run anyway.',
    mac: 'The app is not notarized by Apple yet. If macOS will not open it, go to System Settings, Privacy & Security, and choose Open Anyway.',
    linux: 'Make the AppImage executable (chmod +x), then run it. The .deb installs with your package manager.',
    android: 'Android asks to allow installs from your browser the first time. This app and the one on the Play Store cannot update each other: to switch, uninstall one first, and export your projects before, as they live in the app.',
  },
  fr: {
    windows: 'Windows peut signaler un éditeur inconnu au premier lancement : choisissez Informations complémentaires, puis Exécuter quand même.',
    mac: 'L’application n’est pas encore notariée par Apple. Si macOS refuse de l’ouvrir, allez dans Réglages Système, Confidentialité et sécurité, et choisissez Ouvrir quand même.',
    linux: 'Rendez l’AppImage exécutable (chmod +x), puis lancez-la. Le .deb s’installe avec votre gestionnaire de paquets.',
    android: 'Android demande d’autoriser les installations depuis votre navigateur la première fois. Cette application et celle du Play Store ne peuvent pas se mettre à jour l’une l’autre : pour passer de l’une à l’autre, désinstallez d’abord la première, après avoir exporté vos projets, car ils vivent dans l’application.',
  },
};
// what the desktop app and the CLI do about the watermark until the desktop can sign in
const WATERMARK: Localised<string> = {
  en: 'Until the desktop app can sign in to an account, the desktop app and the CLI keep the Tramme watermark on exported films, as on Basic.',
  fr: 'Tant que l’application de bureau ne peut pas se connecter à un compte, l’application de bureau et la CLI gardent le filigrane Tramme sur les films exportés, comme avec Basic.',
};
const WORDS: Localised<Record<string, string>> = {
  en: { meta: `The Tramme app for ${systemsLine('en')}: your projects on your device, your keys in its secure storage.`, title: 'Download Tramme.', yours: 'Your system', soon: 'Not in this release yet:', releases: 'see the releases', all: 'All releases on GitHub', browser: 'open it in the browser', lead: 'The editor as an app: your projects on your device, your keys in its secure storage.', version: 'Version', news: 'what is new', or: 'Or', nothing: 'with nothing to install', none: 'There is no release of the desktop app yet. Until then,', none2: 'open Tramme in the browser', none3: ', or follow its', none4: 'releases on GitHub' },
  fr: { meta: `L’application Tramme pour ${systemsLine('fr')} : vos projets sur votre appareil, vos clés dans son stockage sécurisé.`, title: 'Télécharger Tramme.', yours: 'Votre système', soon: 'Pas encore dans cette version :', releases: 'voir les versions', all: 'Toutes les versions sur GitHub', browser: 'ouvrez-le dans le navigateur', lead: 'L’éditeur en application : vos projets sur votre appareil, vos clés dans son stockage sécurisé.', version: 'Version', news: 'les nouveautés', or: 'Ou', nothing: 'sans rien installer', none: 'Il n’y a pas encore de version de l’application de bureau. D’ici là,', none2: 'ouvrez Tramme dans le navigateur', none3: ', ou suivez ses', none4: 'versions sur GitHub' },
};
// a visitor on a Mac, when the macOS app is withheld (apps/desktop/downloads.ts): why there is none, and where to go
const MAC: Localised<string> = {
  en: 'The macOS app is not available yet: Apple only lets an app be installed once it is signed, and Tramme’s is not. Meanwhile, Tramme runs in the browser, on a Mac like anywhere else.',
  fr: 'L’application macOS n’est pas encore disponible : Apple n’autorise l’installation d’une application qu’une fois signée, et celle de Tramme ne l’est pas encore. En attendant, Tramme fonctionne dans le navigateur, sur Mac comme ailleurs.',
};
const w = WORDS[locale];
const mb = (bytes: number) => `${Math.round(bytes / 1e6)} MB`;
---

<Page title={w.title.replace('.', '')} description={w.meta}>
    <PageHead title={w.title}>
      {w.lead}{' '}
      {release && <>{w.version} {release.version}, <a href={release.page}>{w.news}</a>.{' '}</>}
      {w.or}{' '}<a href={APP} target="_blank" rel="noopener">{w.browser}</a>, {w.nothing}.
    </PageHead>
    <section class="wrap download-preview">
      <div class="download-intro">
        <h2>{locale === 'fr' ? 'Votre studio, sur votre ordinateur.' : 'Your studio, on your computer.'}</h2>
        <p>{w.lead}</p>
        <a class="btn btn-accent" href={APP} target="_blank" rel="noopener">{locale === 'fr' ? 'Essayer dans le navigateur' : 'Try it in the browser'}</a>
      </div>
    </section>
    <div class="wrap page">

    {release ? (
      <ul class="systems" role="list" style={`--systems: ${OFFERED_SYSTEMS.length}`}>
        {OFFERED_SYSTEMS.map((os) => {
          const files = release.installers.filter((i) => i.os === os);
          return (
            <li class="system" data-for={os}>
              <div class="name"><SystemIcon os={os} /><h2>{SYSTEMS[os]}</h2><span class="yours">{w.yours}</span></div>
              {files.length ? (
                <ul class="files" role="list">
                  {files.map((f, n) => (
                    <li>
                      <a class:list={['btn', n === 0 ? 'btn-accent' : 'btn-ghost']} href={f.href}><DownloadSimple aria-hidden="true" />{f.kind}</a>
                      <span class="meta">{f.runs} · {mb(f.size)}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="meta">{w.soon} <a href={RELEASES}>{w.releases}</a>.</p>
              )}
              <p class="first">{pick(locale, FIRST)[os]}</p>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="none">
        {w.none} <a href={APP} target="_blank" rel="noopener">{w.none2}</a>{w.none3} <a href={RELEASES}>{w.none4}</a>.
      </p>
    )}

    {WITHHELD.includes('mac') && <p class="mac-note">{pick(locale, MAC)} <a href={APP} target="_blank" rel="noopener">{w.none2}</a>.</p>}
    <p class="watermark">{pick(locale, WATERMARK)}</p>
    <p class="all"><a href={RELEASES}>{w.all}<ArrowUpRight aria-hidden="true" /></a></p>
    </div>
</Page>

<style>
  .page { margin-top: clamp(40px, 5vw, 64px); }
  .none a, .meta a { color: var(--accent-text); }

  .systems { display: grid; grid-template-columns: repeat(var(--systems, 3), minmax(0, 1fr)); gap: 20px; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0; list-style: none; }
  .system {
    display: grid; grid-template-rows: auto 1fr auto; gap: 24px; padding: clamp(20px, 2.4vw, 32px);
    border: 1px solid var(--line); border-radius: var(--r); background: var(--panel);
  }
  .name { display: flex; align-items: center; gap: 12px; }
  .name :global(svg) { width: 26px; height: 26px; flex: none; }
  h2 { font-size: 1.5rem; letter-spacing: -0.03em; }
  .yours { display: none; margin-left: auto; white-space: nowrap; padding: 3px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 500; color: var(--accent-text); background: var(--accent-soft); }
  .files { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; align-content: start; }
  .files li { display: grid; gap: 8px; justify-items: start; }
  .meta { font-size: 0.875rem; color: var(--ink-3); }
  .first { padding-top: 18px; border-top: 1px solid var(--line); font-size: 0.875rem; color: var(--ink-3); }

  /* the visitor's system first, and marked */
  :global(:root[data-os='windows']) [data-for='windows'],
  :global(:root[data-os='mac']) [data-for='mac'],
  :global(:root[data-os='linux']) [data-for='linux'],
  :global(:root[data-os='android']) [data-for='android'] { order: -1; border-color: var(--accent); }
  :global(:root[data-os='windows']) [data-for='windows'] .yours,
  :global(:root[data-os='mac']) [data-for='mac'] .yours,
  :global(:root[data-os='linux']) [data-for='linux'] .yours,
  :global(:root[data-os='android']) [data-for='android'] .yours { display: inline-block; }

  .none { max-width: 40rem; margin-top: clamp(40px, 5vw, 64px); padding: 24px; border: 1px solid var(--line); border-radius: var(--r); background: var(--panel); color: var(--ink-2); }
  /* only a visitor on a Mac sees why there is no app for them */
  .mac-note { display: none; max-width: 40rem; margin-top: 32px; padding: 20px 24px; border: 1px solid var(--line-2); border-radius: var(--r); background: var(--panel); color: var(--ink-2); }
  .mac-note a { color: var(--accent-text); }
  :global(:root[data-os='mac']) .mac-note { display: block; }
  .watermark { max-width: 40rem; margin-top: 32px; font-size: 0.9375rem; color: var(--ink-3); }
  .all { margin-top: 20px; font-size: 0.9375rem; }
  .all a { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-2); text-decoration: none; }
  .all a:hover { color: var(--ink); }
  .all svg { width: 16px; height: 16px; }

  @media (max-width: 960px) { .systems { grid-template-columns: minmax(0, 1fr); } }
</style>
