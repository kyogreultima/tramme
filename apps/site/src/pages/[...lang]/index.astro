---
// The landing page, in both languages: the hero with its field, the pillars,
// the community, the platform, the closing call.
import Page from '../../components/Page.astro';
import Hero from '../../components/Hero.astro';
import Tabs from '../../components/Tabs.astro';
import Community from '../../components/Community.astro';
import Bento from '../../components/Bento.astro';
import Closing from '../../components/Closing.astro';
import { landingData } from '../../lib/site';
import { previewUrl } from '../../lib/preview';
import { localeOf, localePaths, t } from '../../lib/i18n';
import { SYSTEMS } from '../../../../desktop/downloads.ts';

export const getStaticPaths = localePaths;

const locale = localeOf(Astro.url.pathname);
// what the search engines read of the page: the site, its questions, the app, its code
const systems = [...new Set(__RELEASE__?.installers.map((i) => SYSTEMS[i.os]))];
const data = landingData(Astro.site!, previewUrl(Astro.site), systems, locale);
---

<Page title={t(locale, 'landing.metaTitle')} description={t(locale, 'landing.metaDescription')}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(data)} />
  <Hero locale={locale} />
  <Tabs locale={locale} />
  <Community locale={locale} />
  <Bento locale={locale} />
  <Closing locale={locale} />
</Page>
