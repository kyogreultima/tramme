---
// Everything the platform does, section by section: the studio, the atelier,
// the assistant, the packs, the way animation is made, the export, the toolbox
// and the cloud services. The landing shows each in a line and leads here.
import Page from '../../components/Page.astro';
import PageHead from '../../components/PageHead.astro';
import Studio from '../../components/Studio.astro';
import Editor from '../../components/Editor.astro';
import Assistant from '../../components/Assistant.astro';
import Packs from '../../components/Packs.astro';
import Inside from '../../components/Inside.astro';
import Render from '../../components/Render.astro';
import Tools from '../../components/Tools.astro';
import Cloud from '../../components/Cloud.astro';
import Proofs from '../../components/Proofs.astro';
import Closing from '../../components/Closing.astro';
import { localeOf, localePaths, pick, t } from '../../lib/i18n';
import { FEATURES, wordsOf } from '../../lib/features';
import { PROOFS_NAME } from '../../lib/proofs';

export const getStaticPaths = localePaths;

const locale = localeOf(Astro.url.pathname);
---

<Page title={t(locale, 'features.metaTitle')} description={t(locale, 'features.metaDescription')}>
  <PageHead title={t(locale, 'features.title')} lead={t(locale, 'features.lead')} />
  <nav class="wrap feature-index" aria-label={t(locale, 'landing.pillars.label')}>
    {FEATURES.map((feature) => <a href={`#${feature.id}`}>{wordsOf(feature, locale).name}</a>)}
    <a href="#proofs">{pick(locale, PROOFS_NAME)}</a>
  </nav>
  <Studio locale={locale} />
  <Editor locale={locale} />
  <Assistant locale={locale} />
  <Packs locale={locale} />
  <Inside locale={locale} />
  <Render locale={locale} />
  <Tools locale={locale} />
  <Cloud locale={locale} />
  <Proofs locale={locale} />
  <Closing locale={locale} />
</Page>
