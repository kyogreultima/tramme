---
// The visitor's system, before the first paint: data-os on <html> (windows,
// mac, linux, android), read by the download button (DownloadLink.astro) and
// the download page. An iPhone, an iPad or a system it cannot tell sets
// nothing: the button then leads to the download page, where one is chosen.
// The detection is lib/os.ts, whose source is what the page runs.
import { osOf } from '../lib/os';
const detect = `(${osOf.toString()})`;
const run = `(() => {
  const detect = ${detect};
  const set = () => {
    const n = navigator, p = (n.userAgentData && n.userAgentData.platform) || n.platform || '';
    const os = detect(n.userAgent, p, n.maxTouchPoints);
    if (os) document.documentElement.dataset.os = os;
  };
  set();
  // the router swaps <html>'s attributes at each page
  document.addEventListener('astro:after-swap', set);
})();`;
---

<script is:inline set:html={run}></script>
