---
// "Explore the inside of every project": the community's latest public
// projects, as cards, and the way to all of them. As many as there are, up to
// eight; none, and only the link remains.
import Head from './Head.astro';
import ProjectCard from './ProjectCard.astro';
import { listProjects } from '../lib/gallery';
import { pathIn, t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const projects = await listProjects({ limit: 8 });
---

<section class="section screen" id="community">
  <div class="bleed">
    <Head title={t(locale, 'landing.community.title')} more={t(locale, 'landing.community.more')} />
    {projects.length > 0
      ? <div class="grid">{projects.map((project) => <ProjectCard project={project} locale={locale} />)}</div>
      : <p class="none">{t(locale, 'card.empty')}</p>}
    <p class="all"><a class="btn btn-ghost" href={pathIn(locale, '/explore/')}>{t(locale, 'landing.community.all')}</a></p>
  </div>
</section>

<style>
  .section { padding-bottom: var(--section); }
  /* edge to edge, tightly set: the first film is the large one */
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(180px, 19vw, 300px); grid-auto-flow: dense; gap: 12px; }
  .grid > :global(*):first-child { grid-column: span 2; grid-row: span 2; }
  .none { color: var(--ink-3); }
  .all { display: flex; margin-top: 40px; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid { grid-template-columns: minmax(0, 1fr); } .grid > :global(*):first-child { grid-column: auto; grid-row: auto; } }
</style>
