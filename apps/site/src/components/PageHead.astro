---
// The head of a page of the site: its title, centred, and a quieter sentence
// under it (the `lead` prop, or the slot when it carries a link)
import { localeOf, t } from '../lib/i18n';
const locale = localeOf(Astro.url.pathname);
const section = Astro.url.pathname.replace(/^\/fr(?=\/|$)/, '').split('/')[1];
const labels: Record<string, string> = { features: 'nav.features', pricing: 'nav.pricing', explore: 'footer.community', download: 'nav.download', about: 'footer.company', roadmap: 'footer.roadmap', privacy: 'footer.company', terms: 'footer.company', '404': 'nav.home' };
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
const hasLead = Boolean(lead) || Astro.slots.has('default');
---

<header class="wrap page-head">
  {labels[section] && <span class="eyebrow">{t(locale, labels[section])}</span>}
  <h1>{title}</h1>
  {hasLead && <p>{lead}<slot /></p>}
</header>

<style>
  .page-head { display: grid; justify-items: start; gap: 24px; padding-top: clamp(48px, 8vw, 120px); text-align: left; max-width: var(--max); }
  h1 { max-width: 16ch; font-size: clamp(3rem, 8.6vw, 9rem); line-height: 0.9; letter-spacing: -0.04em; }
  p { max-width: 38rem; font-size: clamp(1.125rem, 1.6vw, 1.375rem); line-height: 1.5; color: var(--ink-2); }
  p :global(a) { color: var(--accent-text); text-underline-offset: 3px; }
</style>
