---
import Brand from './Brand.astro';
import Menu from './Menu.astro';
import { barButtons, barLinks, menus } from '../lib/nav';
import { localeOf, pathIn, t } from '../lib/i18n';

const locale = localeOf(Astro.url.pathname);
const bar = menus(locale);
const links = barLinks(locale);
const { logIn, start } = barButtons(locale);
---

<header class="nav">
  <nav class="wrap row" aria-label={t(locale, 'nav.main')}>
    <a class="home" href={pathIn(locale, '/')} aria-label={t(locale, 'nav.home')}><Brand /></a>
    <ul class="links" role="list">
      {bar.map((menu) => <li><Menu menu={menu} /></li>)}
      {links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
    </ul>
    <div class="end">
      <a class="btn btn-ghost btn-sm login" href={logIn.href}>{logIn.label}</a>
      <a class="btn btn-accent btn-sm start" href={start.href}>{start.label}</a>
      <!-- under 960 px, everything in one menu, the two buttons included -->
      <details class="fold" name="nav-menu">
        <summary class="btn btn-ghost btn-sm">{t(locale, 'nav.menu')}</summary>
        <div class="panel">
          {bar.map((menu) => (
            <section>
              <strong>{menu.label}</strong>
              <ul role="list">{menu.links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
            </section>
          ))}
          <ul role="list">{links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
          <div class="buttons">
            <a class="btn btn-ghost" href={logIn.href}>{logIn.label}</a>
            <a class="btn btn-accent" href={start.href}>{start.label}</a>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  // The menus are <details>: they open without script. This only adds Escape and a
  // click outside to close one, and closes it when a link in it is followed
  // (an anchor of the page you are on does not reload it)
  const open = () => document.querySelectorAll<HTMLDetailsElement>('.nav details[open]');
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const d of open()) {
      if (d.contains(document.activeElement)) d.querySelector('summary')?.focus();
      d.open = false;
    }
  });
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    for (const d of open()) if (!d.contains(target) || target.closest('a')) d.open = false;
  });
</script>

<style>
  /* a flat bar, edge to edge: the page passes under it, blurred */
  .nav { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 78%, transparent); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  .row { display: flex; align-items: center; gap: 28px; height: var(--nav); max-width: none; }
  .home { flex: none; text-decoration: none; font-size: 1.15rem; }
  .links { display: flex; gap: 4px; margin: 0 auto; padding: 0; list-style: none; }
  .links > li > a { display: block; padding: 7px 12px; border-radius: 999px; color: var(--ink-2); text-decoration: none; font-size: 0.875rem; transition: color 0.2s var(--ease), background-color 0.2s var(--ease); }
  .links > li > a:hover { color: var(--ink); background: var(--hover); }
  .end { display: flex; align-items: center; gap: 8px; }
  .fold { position: relative; display: none; }
  .fold summary { list-style: none; }
  .fold summary::-webkit-details-marker { display: none; }
  .panel {
    position: absolute; top: calc(100% + 14px); right: 0; z-index: 2; display: grid; gap: 14px; width: min(86vw, 320px); padding: 16px;
    /* a short screen (a phone on its side): the panel scrolls inside itself, the bar being fixed */
    max-height: calc(100dvh - var(--nav) - 24px); overflow-y: auto; overscroll-behavior: contain;
    background: var(--panel); border-radius: var(--r-lg); box-shadow: var(--float);
  }
  .panel strong { display: block; margin-bottom: 4px; font-size: 0.8125rem; font-weight: 500; color: var(--ink-3); }
  .panel ul { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .panel a { display: block; padding: 8px 10px; border-radius: 10px; color: var(--ink); text-decoration: none; font-size: 0.9375rem; }
  .panel a:hover { background: var(--hover); }

  .buttons { display: grid; gap: 8px; padding-top: 6px; }

  @media (max-width: 960px) {
    .links, .login { display: none; }
    .end { margin-left: auto; }
    .fold { display: block; }
  }
  /* a phone: both buttons are in the menu */
  @media (max-width: 560px) { .start { display: none; } }
</style>
