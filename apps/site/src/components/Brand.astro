---
// The logo (brand/svg/logo-on-light.svg), on the landing page and in the docs,
// inline so the theme colours it: the mark in the accent, the letters in the
// ink, as the app's own interface (theme.css), whichever theme is chosen.
import Logo from '../../../../brand/svg/logo-on-light.svg';
---

<span class="brand" role="img" aria-label="Tramme"><Logo aria-hidden="true" /></span>

<style>
  .brand { display: inline-flex; height: 1.5em; }
  .brand :global(svg) { height: 100%; width: auto; }
  /* the file's own colours are classes set in its <style>: the mark, then the letters */
  .brand :global(.cls-1) { fill: var(--accent); }
  .brand :global(.cls-2), .brand :global(.cls-3) { fill: var(--ink); }
</style>
