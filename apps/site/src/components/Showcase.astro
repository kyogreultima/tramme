---
import Media from './Media.astro';
import { signUp } from '../lib/links';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="showcase wrap" id="film">
  <div class="demo">
    <div class="intro">
      <span class="section-label">{t(locale, 'landing.showcase.label')}</span>
      <h2>{t(locale, 'landing.showcase.title')}</h2>
      <p>{t(locale, 'landing.showcase.more')}</p>
      <a class="btn btn-ghost" href={signUp({ lang: locale })} target="_blank" rel="noopener">{t(locale, 'landing.hero.send')}</a>
    </div>
    <Media id="tramme" width={1920} height={1080} label={t(locale, 'landing.hero.demo')} />
  </div>
  <div class="notes">
    <div><h3>{t(locale, 'landing.showcase.directionTitle')}</h3><p>{t(locale, 'landing.showcase.direction')}</p></div>
    <div><h3>{t(locale, 'landing.showcase.controlTitle')}</h3><p>{t(locale, 'landing.showcase.control')}</p></div>
  </div>
</section>
<style>
  .showcase { padding-top: 24px; }
  .demo { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 2fr); gap: clamp(32px, 5vw, 80px); align-items: center; border-top: 1px solid var(--line); padding-block: 32px; }
  .section-label { font-size: 0.6875rem; color: var(--ink-2); }
  .showcase h2 { max-width: 19ch; margin-top: 24px; font-size: clamp(1.7rem, 2.3vw, 2.5rem); }
  .intro p { max-width: 36ch; margin-top: 16px; font-size: 0.875rem; color: var(--ink-2); }
  .intro a { margin-top: 24px; }
  .notes { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 7vw, 100px); padding-block: clamp(40px, 6vw, 80px); border-top: 1px solid var(--line); }
  h3 { max-width: 22ch; font-size: clamp(1.5rem, 2.2vw, 2.3rem); line-height: 1.2; }
  .notes p { max-width: 48ch; margin-top: 20px; color: var(--ink-2); font-size: 0.875rem; }
  @media (max-width: 800px) { .demo, .notes { grid-template-columns: 1fr; } .demo { gap: 28px; } .notes { gap: 40px; } }
</style>
