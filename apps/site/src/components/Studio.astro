---
// The studio, the app's first view: the film in front, directed by notes.
import PushPin from '@phosphor-icons/core/assets/regular/push-pin.svg';
import FilmSlate from '@phosphor-icons/core/assets/regular/film-slate.svg';
import Compass from '@phosphor-icons/core/assets/regular/compass.svg';
import Head from './Head.astro';
import Shot from './Shot.astro';
import Cards from './Cards.astro';
import { shotOf } from '../lib/features';
import { pick, type Locale, type Localised } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

const COPY: Localised<{ title: string; more: string; items: [string, string][] }> = {
  en: {
    title: 'Direct the film in words.',
    more: 'The studio puts the film in front: you leave notes, Tramme answers with takes.',
    items: [
      ['Notes, pinned', 'Say what should change, as you would to an editor. Pin a note to a moment or a place of the frame, or to a scene of the storyboard.'],
      ['Takes, not surprises', 'Tramme answers with a take shown on the picture. Keep it, or set it aside: nothing lands in the film without you.'],
      ['A direction it follows', 'The brief (subject, tone, rules), the palette and the material of the film, read before anything is staged.'],
    ],
  },
  fr: {
    title: 'Dirigez le film avec des mots.',
    more: 'Le studio met le film au premier plan : vous laissez des notes, Tramme répond par des prises.',
    items: [
      ['Des notes, épinglées', 'Dites ce qui doit changer, comme à un monteur. Épinglez une note à un instant ou à un endroit de l\'image, ou à une scène du storyboard.'],
      ['Des prises, pas des surprises', 'Tramme répond par une prise montrée sur l\'image. Gardez-la ou écartez-la : rien n\'entre dans le film sans vous.'],
      ['Une direction qu\'il suit', 'Le brief (sujet, ton, règles), la palette et la matière du film, lus avant de mettre quoi que ce soit en scène.'],
    ],
  },
};
const c = pick(locale, COPY);
const ICONS = [PushPin, FilmSlate, Compass];
const items = c.items.map(([title, text], i) => ({ Icon: ICONS[i], title, text }));
const { shot, alt } = shotOf('studio');
---

<section class="section" id="studio">
  <div class="wrap">
    <Head title={c.title} more={c.more} />
  </div>
  <div class="wrap">
    <Shot light={shot[0]} dark={shot[1]} alt={pick(locale, alt)} />
    <Cards items={items} />
  </div>
</section>
