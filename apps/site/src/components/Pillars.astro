---
// The five things Tramme does (lib/features.ts). The studio, the first, is
// told across the page with a piece of its interface floating over the
// picture; the others in turn, a text and a picture, sides alternating. Each
// leads to its section of the features page.
import { Image } from 'astro:assets';
import ArrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg';
import Head from './Head.astro';
import Shot from './Shot.astro';
import { FEATURES, shotOf } from '../lib/features';

const [lead, ...rest] = FEATURES;
// only the note box floats over the studio here
const { shot, alt, parts } = shotOf('studio');
const floating = parts?.filter((p) => p.class === 'composer');
---

<section class="section" id="pillars">
  <div class="wrap">
    <Head title="What it does." more="Direct, refine, delegate, extend, export: one film, all the way." />
  </div>

  <div class="wrap lead" data-reveal>
    <div class="text">
      <h3>{lead.name}</h3>
      <p>{lead.line}</p>
      <a class="more" href={`/features/#${lead.id}`} aria-label={`Learn more about the ${lead.name.toLowerCase()}`}>Learn more<ArrowRight aria-hidden="true" /></a>
    </div>
  </div>
  <div class="wrap-wide shot">
    <Shot light={shot[0]} dark={shot[1]} alt={alt} parts={floating} />
  </div>

  <div class="wrap rows">
    {rest.map((f, i) => (
      <article class:list={['row', { reverse: i % 2 === 1 }]} data-reveal>
        <div class="text">
          <h3>{f.name}</h3>
          <p>{f.line}</p>
          <a class="more" href={`/features/#${f.id}`} aria-label={`Learn more about the ${f.name.toLowerCase()}`}>Learn more<ArrowRight aria-hidden="true" /></a>
        </div>
        <div class="picture">
          {'shot' in f.picture
            ? <Shot light={f.picture.shot[0]} dark={f.picture.shot[1]} alt={f.picture.alt} flat />
            : <Image class="still" src={f.picture.still} alt={f.picture.alt} widths={[560, 960, 1280]} sizes="(max-width: 860px) 100vw, 640px" loading="lazy" decoding="async" />}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .lead { margin-top: clamp(40px, 5vw, 64px); }
  .shot { margin-top: clamp(28px, 4vw, 48px); }
  .rows { display: grid; gap: clamp(56px, 7vw, 104px); margin-top: clamp(72px, 9vw, 136px); }
  .row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: clamp(28px, 5vw, 80px); }
  .reverse .text { order: 2; }
  h3 { font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.08; }
  .text p { margin-top: 14px; max-width: 30rem; font-size: 1.0625rem; line-height: 1.55; color: var(--ink-2); }
  .more { display: inline-flex; align-items: center; gap: 6px; margin-top: 20px; color: var(--accent-text); font-size: 0.9375rem; font-weight: 500; text-decoration: none; }
  .more :global(svg) { width: 16px; height: 16px; transition: transform 0.2s var(--ease); }
  .more:hover :global(svg) { transform: translateX(3px); }
  .still { width: 100%; height: auto; border-radius: var(--r-lg); box-shadow: var(--float); }
  @media (max-width: 860px) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .reverse .text { order: 0; }
  }
</style>
