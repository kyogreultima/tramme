---
// What Tramme does, in one frame: a row of choices (Studio, Atelier, Assistant,
// Packs, Export) and under it the picture and the sentence of the one chosen.
// Radio inputs and CSS, no script: the arrow keys move from one to the next,
// and without CSS every picture simply follows the last. Only the picture
// shown loads (the others are lazy and not displayed). The rules that tie a
// choice to its panel are written from the list (lib/features.ts), so the list
// can change without this file.
import { Image } from 'astro:assets';
import ArrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg';
import Head from './Head.astro';
import Shot from './Shot.astro';
import { FEATURES, PILLARS, wordsOf } from '../lib/features';
import { pathIn, t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
// the landing shows the four pillars; the features page details them all
const pillars = PILLARS.map((id) => FEATURES.find((f) => f.id === id)!);

const rules = pillars.map(({ id }) => [
  `.tabs > #tab-${id}:checked ~ .bar label[for='tab-${id}'] { color: var(--ink); }`,
  `.tabs > #tab-${id}:focus-visible ~ .bar label[for='tab-${id}'] { outline: 2px solid var(--accent-text); outline-offset: 2px; }`,
  `.tabs > #tab-${id}:checked ~ .panels [data-panel='${id}'] { display: grid; }`,
].join('\n')).join('\n');
---

<section class="section" id="product">
  <div class="wrap">
    <Head title={t(locale, 'landing.pillars.title')} more={t(locale, 'landing.pillars.more')} />
    <div class="tabs" role="radiogroup" aria-label={t(locale, 'landing.pillars.label')}>
      {pillars.map(({ id }, i) => <input class="sr" type="radio" name="feature" id={`tab-${id}`} checked={i === 0} />)}
      <div class="bar">
        {pillars.map((f) => <label for={`tab-${f.id}`}>{wordsOf(f, locale).name}</label>)}
      </div>
      <div class="panels">
        {pillars.map((f) => {
          const { name, line, alt } = wordsOf(f, locale);
          const { id, picture } = f;
          return (
          <div class="panel" data-panel={id}>
            {'shot' in picture
              ? <Shot light={picture.shot[0]} dark={picture.shot[1]} alt={alt} />
              : <Image class="still" src={picture.still} alt={alt} widths={[800, 1280, 1760]} sizes="(max-width: 1280px) 100vw, 1280px" loading="lazy" decoding="async" />}
            <div class="words">
              <p>{line}</p>
              <a class="more" href={pathIn(locale, `/features/#${id}`)} aria-label={t(locale, 'landing.pillars.moreAbout', { name })}>{t(locale, 'landing.pillars.learn')}<ArrowRight aria-hidden="true" /></a>
            </div>
          </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style is:inline set:html={rules}></style>

<style>
  /* the names are the controls: large type on the left, the picture they choose on the right */
  .tabs { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(24px, 4vw, 72px); align-items: start; }
  .sr { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .bar { display: grid; gap: 4px; position: sticky; top: calc(var(--nav) + 24px); }
  label { display: block; padding-block: 2px; font-family: var(--font-head); font-size: clamp(2.5rem, 5.6vw, 5.5rem); font-weight: 700; line-height: 1; letter-spacing: -0.035em; color: var(--ink-3); cursor: pointer; transition: color 0.25s var(--ease); }
  label:hover { color: var(--ink-2); }
  .panels { min-width: 0; }
  .panel { display: none; gap: 24px; }
  .panel > :global(.shot), .panel > :global(.still) { width: 100%; }
  /* the stills take the screenshots' shape, so the frame keeps its height from one choice to the next */
  .panel :global(.still) { aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--r-lg); box-shadow: var(--lift); }
  .panel :global(.shot) { border-radius: var(--r-lg); }
  .words { display: grid; justify-items: start; gap: 12px; }
  .words p { max-width: 34rem; font-size: clamp(1.0625rem, 1.5vw, 1.3125rem); line-height: 1.5; color: var(--ink-2); }
  .more { display: inline-flex; align-items: center; gap: 6px; color: var(--accent-text); font-size: 1rem; font-weight: 500; text-decoration: none; }
  .more :global(svg) { width: 16px; height: 16px; transition: transform 0.2s var(--ease); }
  .more:hover :global(svg) { transform: translateX(3px); }
  @media (max-width: 960px) {
    .tabs { grid-template-columns: minmax(0, 1fr); }
    .bar { position: static; display: flex; flex-wrap: wrap; gap: 4px 20px; }
    label { font-size: clamp(2rem, 9vw, 3rem); }
  }
</style>
