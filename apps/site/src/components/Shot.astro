---
// A picture of the app in the page's theme: its paper theme on the light
// page, its studio theme on the dark one. Both are lazy, so only the one
// shown loads. Framed and flat, at the container's width.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { light: ImageMetadata; dark: ImageMetadata; alt: string }
const { light, dark, alt } = Astro.props;
const pair = [['light', light], ['dark', dark]] as const;
---

<div class="shot">
  {pair.map(([theme, src]) => (
    <Image class={theme} src={src} alt={alt} widths={[800, 1280, 1760, 2560]} sizes="(max-width: 1280px) 100vw, 1280px" loading="lazy" decoding="async" />
  ))}
</div>

<style>
  .shot { overflow: hidden; border-radius: var(--r-lg); box-shadow: var(--lift); background: var(--panel); }
  .shot :global(img) { width: 100%; height: auto; }
  .shot :global(.dark), :global([data-theme='dark']) .shot :global(.light) { display: none; }
  :global([data-theme='dark']) .shot :global(.dark) { display: block; }
</style>
