---
// The packs that ship with the editor, in what they put on screen: icons,
// diagrams, figures, charts, type, physics. Each is an ordinary plugin, added
// to a project in a click, and reached by the assistant without being asked.
import Shapes from '@phosphor-icons/core/assets/regular/shapes.svg';
import TreeStructure from '@phosphor-icons/core/assets/regular/tree-structure.svg';
import PersonSimpleWalk from '@phosphor-icons/core/assets/regular/person-simple-walk.svg';
import ChartBar from '@phosphor-icons/core/assets/regular/chart-bar.svg';
import TextAa from '@phosphor-icons/core/assets/regular/text-aa.svg';
import Atom from '@phosphor-icons/core/assets/regular/atom.svg';
import Head from './Head.astro';
import Cards from './Cards.astro';
import { docHref } from '../lib/docs';
import { pick, type Locale, type Localised } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

const COPY: Localised<{ title: string; more: string; items: [string, string][]; also: string; next: string }> = {
  en: {
    title: 'Packs for what comes up often.',
    more: 'Added to a project in a click, and the assistant reaches for them on its own.',
    items: [
      ['Icons that draw themselves', 'Over two thousand Lucide icons, found by a word or two, laid in a row, a grid or beside a list, in the colours of the film.'],
      ['Diagrams from a few lines', 'Write a flow as text, the Mermaid way. Tramme lays it out, draws it on box after box, and can light one route through it.'],
      ['Stick figures', 'Pivot-style characters posed joint by joint, reaching for a point, or already walking.'],
      ['Charts', 'Bars, lines and donuts from a data set, animated, and checked for readability.'],
      ['Kinetic type', 'Letters that type, wave, scatter, drop or rise from a mask.'],
      ['Physics', 'Confetti, bouncing balls, a rope, letters that fall and settle: the same on every render.'],
    ],
    also: 'Also a UI walkthrough, accessibility checks and localization. Any SVG turns into paths whose strokes draw themselves.',
    next: 'See what comes next',
  },
  fr: {
    title: 'Des packs pour ce qui revient souvent.',
    more: 'Ajoutés à un projet en un clic, et l\'assistant y a recours de lui-même.',
    items: [
      ['Des icônes qui se dessinent', 'Plus de deux mille icônes Lucide, trouvées en un mot ou deux, disposées en ligne, en grille ou à côté d\'une liste, aux couleurs du film.'],
      ['Des schémas en quelques lignes', 'Écrivez un flux en texte, à la manière de Mermaid. Tramme le met en page, le dessine boîte après boîte, et peut éclairer un chemin à travers.'],
      ['Des bonshommes', 'Des personnages façon pivot, posés articulation par articulation, qui tendent la main vers un point, ou marchent déjà.'],
      ['Des graphiques', 'Barres, courbes et anneaux depuis un jeu de données, animés, et vérifiés pour la lisibilité.'],
      ['De la typographie animée', 'Des lettres qui s\'écrivent, ondulent, se dispersent, tombent ou montent depuis un masque.'],
      ['De la physique', 'Confettis, balles qui rebondissent, une corde, des lettres qui tombent et se posent : pareil à chaque rendu.'],
    ],
    also: 'Aussi un pas à pas d\'interface, des contrôles d\'accessibilité et la localisation. Tout SVG devient des tracés qui se dessinent seuls.',
    next: 'Voir la suite',
  },
};
const c = pick(locale, COPY);
const ICONS = [Shapes, TreeStructure, PersonSimpleWalk, ChartBar, TextAa, Atom];
const items = c.items.map(([title, text], i) => ({ Icon: ICONS[i], title, text }));
---

<section class="section" id="packs">
  <div class="wrap">
    <Head title={c.title} more={c.more} />
    <div class="body">
      <Cards items={items} />
      <p class="more" data-reveal>{c.also} <a href={docHref('roadmaps/packs')}>{c.next}</a>.</p>
    </div>
  </div>
</section>

<style>
  .more { margin-top: 20px; text-align: center; font-size: 0.9375rem; color: var(--ink-3); }
  .more a { color: var(--accent-text); text-underline-offset: 3px; }
</style>
