---
// The packs that ship with the editor, in what they put on screen: icons,
// diagrams, figures, charts, type, physics. Each is an ordinary plugin, added
// to a project in a click, and reached by the assistant without being asked.
import Shapes from '@phosphor-icons/core/assets/regular/shapes.svg';
import TreeStructure from '@phosphor-icons/core/assets/regular/tree-structure.svg';
import PersonSimpleWalk from '@phosphor-icons/core/assets/regular/person-simple-walk.svg';
import ChartBar from '@phosphor-icons/core/assets/regular/chart-bar.svg';
import TextAa from '@phosphor-icons/core/assets/regular/text-aa.svg';
import Atom from '@phosphor-icons/core/assets/regular/atom.svg';
import Head from './Head.astro';
import Cards from './Cards.astro';
import { docHref } from '../lib/docs';

const ITEMS = [
  { Icon: Shapes, title: 'Icons that draw themselves', text: 'Over two thousand Lucide icons, found by a word or two, laid in a row, a grid or beside a list, in the colours of the film.' },
  { Icon: TreeStructure, title: 'Diagrams from a few lines', text: 'Write a flow as text, the Mermaid way. Tramme lays it out, draws it on box after box, and can light one route through it.' },
  { Icon: PersonSimpleWalk, title: 'Stick figures', text: 'Pivot-style characters posed joint by joint, reaching for a point, or already walking.' },
  { Icon: ChartBar, title: 'Charts', text: 'Bars, lines and donuts from a data set, animated, and checked for readability.' },
  { Icon: TextAa, title: 'Kinetic type', text: 'Letters that type, wave, scatter, drop or rise from a mask.' },
  { Icon: Atom, title: 'Physics', text: 'Confetti, bouncing balls, a rope, letters that fall and settle: the same on every render.' },
];
---

<section class="section" id="packs">
  <div class="wrap">
    <Head title="Packs for what comes up often." more="Added to a project in a click, and the assistant reaches for them on its own." />
    <div class="body">
      <Cards items={ITEMS} />
      <p class="more" data-reveal>Also a UI walkthrough, accessibility checks and localization. Any SVG turns into paths whose strokes draw themselves. <a href={docHref('roadmaps/packs')}>See what comes next</a>.</p>
    </div>
  </div>
</section>

<style>
  .more { margin-top: 20px; text-align: center; font-size: 0.9375rem; color: var(--ink-3); }
  .more a { color: var(--accent-text); text-underline-offset: 3px; }
</style>
