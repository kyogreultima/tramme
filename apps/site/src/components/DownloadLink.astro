---
// The app for the visitor's system (Platform.astro), from the latest
// release on GitHub (lib/download.ts): its first installer. Another system,
// or one that cannot be told, gets the download page instead. Nothing without
// a release.
import DownloadSimple from '@phosphor-icons/core/assets/regular/download-simple.svg';
import SystemIcon from './SystemIcon.astro';
import { OFFERED_SYSTEMS, SYSTEMS } from '../../../desktop/downloads.ts';
import { localeOf, pathIn, t } from '../lib/i18n';
const locale = localeOf(Astro.url.pathname);

const release = __RELEASE__;
const firsts = release ? OFFERED_SYSTEMS.flatMap((os) => release.installers.find((i) => i.os === os) ?? []) : [];
---

{release && (
  <span class="download">
    {firsts.map((i) => (
      <a class="btn btn-ghost" data-for={i.os} href={i.href} title={`Tramme ${release.version}, ${i.kind.toLowerCase()} for ${i.runs}, ${Math.round(i.size / 1e6)} MB`}>
        <SystemIcon os={i.os} />{t(locale, 'common.downloadFor', { system: SYSTEMS[i.os] })}
      </a>
    ))}
    <a class="btn btn-ghost any" href={pathIn(locale, '/download/')}><DownloadSimple aria-hidden="true" />{t(locale, 'common.downloadApp')}</a>
  </span>
)}

<style>
  /* the buttons sit in their row as if this wrapper were not there */
  .download { display: contents; }
  .download [data-for] { display: none; }
  :global(:root[data-os='windows']) [data-for='windows'],
  :global(:root[data-os='mac']) [data-for='mac'],
  :global(:root[data-os='linux']) [data-for='linux'],
  :global(:root[data-os='android']) [data-for='android'] { display: inline-flex; }
  :global(:root[data-os='windows']) .download:has([data-for='windows']) .any,
  :global(:root[data-os='mac']) .download:has([data-for='mac']) .any,
  :global(:root[data-os='linux']) .download:has([data-for='linux']) .any,
  :global(:root[data-os='android']) .download:has([data-for='android']) .any { display: none; }
</style>
