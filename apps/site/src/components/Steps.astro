---
// How a film is made, in three moves, and the toolbox under it as a strip of
// chips: what a motion designer looks for first, before any detail.
const STEPS = [
  { title: 'Say what you want', text: 'A sentence, a brief, a video or a folder of material. Tramme stages a first cut.' },
  { title: 'Direct it with notes', text: 'Pin a note to a moment or a spot in the frame. Each answer comes back as a take to keep or set aside.' },
  { title: 'Refine, then export', text: 'Open the atelier for the last keyframe, then export MP4, transparent video, GIF or Lottie.' },
];
const TOOLS = [
  'Keyframes', 'Graph editor', 'Wiggle, loop, spring', 'Precompositions', 'Components', '2.5D camera', 'Motion blur', 'Masks and mattes',
  'Colour grading', 'Chroma key', 'Transitions', 'Time displacement', 'Self-drawing strokes', 'Particles', 'Shaders',
  'Frame-by-frame drawing', 'Captions from speech', 'Sound library', 'Transparent video', 'Lottie',
];
---

<section class="section steps-section" aria-label="How it works">
  <div class="wrap">
    <ol class="steps" role="list" data-reveal>
      {STEPS.map(({ title, text }) => (
        <li class="surface">
          <strong>{title}</strong>
          <p>{text}</p>
        </li>
      ))}
    </ol>
    <ul class="tools" role="list" aria-label="In the toolbox" data-reveal>
      {TOOLS.map((tool) => <li>{tool}</li>)}
    </ul>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); margin: 0; padding: 0; list-style: none; }
  .steps li { position: relative; display: grid; align-content: start; gap: 8px; padding: clamp(22px, 2.4vw, 32px); }
  .steps strong { font-size: clamp(1.25rem, 1.8vw, 1.5rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.2; }
  .steps p { font-size: 0.9375rem; line-height: 1.55; color: var(--ink-3); }

  .tools { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: clamp(28px, 3.5vw, 44px) auto 0; padding: 0; max-width: 980px; list-style: none; }
  .tools li { height: 34px; padding: 0 14px; display: inline-flex; align-items: center; border-radius: 999px; background: var(--panel); box-shadow: inset 0 0 0 1px var(--line); font-size: 0.875rem; color: var(--ink-2); white-space: nowrap; }

  @media (max-width: 860px) {
    .steps { grid-template-columns: minmax(0, 1fr); }
  }
</style>
