---
// The footer's way back to the audience-measurement choice (Consent.astro
// listens for the click). Hidden until the script is there: without it, it
// would do nothing.
import { localeOf, t } from '../lib/i18n';

const locale = localeOf(Astro.url.pathname);
---

<button type="button" class="choice" data-consent-open hidden>{t(locale, 'consent.manage')}</button>

<style>
  .choice[hidden] { display: none; }
  .choice {
    padding: 5px 14px; border: 1px solid var(--line-2); border-radius: var(--tramme-radius-control); background: transparent;
    color: var(--ink-3); font: inherit; font-size: 0.875rem; cursor: pointer; transition: background-color 0.2s var(--ease, ease), color 0.2s var(--ease, ease);
  }
  .choice:hover { background: var(--hover); color: var(--ink); }
</style>
