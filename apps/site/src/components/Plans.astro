---
// The three plans side by side, with the choice of period (monthly or yearly):
// two radio inputs and CSS, no script. PlanCard shows the price of the
// period chosen.
import PlanCard from './PlanCard.astro';
import { PLAN_IDS } from '../lib/plans';
import { t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<div class="plans">
  <div class="switch" role="radiogroup" aria-label={t(locale, 'plans.period')}>
    <input class="sr" type="radio" name="period" id="period-month" checked />
    <label for="period-month">{t(locale, 'plans.monthly')}</label>
    <input class="sr" type="radio" name="period" id="period-year" />
    <label for="period-year">{t(locale, 'plans.yearly')}</label>
  </div>
  <div class="cards">
    {PLAN_IDS.map((id) => <PlanCard planId={id} locale={locale} featured={id === 'plus'} />)}
  </div>
</div>

<style>
  .plans { display: grid; justify-items: center; gap: 32px; }
  .sr { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .switch { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--panel); box-shadow: inset 0 0 0 1px var(--line); }
  label { display: inline-flex; align-items: center; height: 38px; padding: 0 20px; border-radius: 999px; color: var(--ink-2); font-size: 0.9375rem; font-weight: 500; cursor: pointer; transition: background-color 0.2s var(--ease), color 0.2s var(--ease); }
  label:hover { background: var(--hover); color: var(--ink); }
  #period-month:checked ~ label[for='period-month'], #period-year:checked ~ label[for='period-year'] { background: var(--accent); color: var(--accent-ink); }
  #period-month:focus-visible ~ label[for='period-month'], #period-year:focus-visible ~ label[for='period-year'] { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; width: 100%; }
  @media (max-width: 960px) { .cards { grid-template-columns: minmax(0, 1fr); max-width: 30rem; } }
</style>
