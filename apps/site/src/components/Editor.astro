---
// The atelier, one switch away from the studio: every layer, key and curve.
import Scissors from '@phosphor-icons/core/assets/regular/scissors.svg';
import BezierCurve from '@phosphor-icons/core/assets/regular/bezier-curve.svg';
import Sliders from '@phosphor-icons/core/assets/regular/sliders-horizontal.svg';
import Head from './Head.astro';
import Shot from './Shot.astro';
import Cards from './Cards.astro';
import light from '../assets/editor-light.png';
import dark from '../assets/editor-dark.png';

const ITEMS = [
  { Icon: Scissors, title: 'A timeline with its own menus', text: 'Split a clip at the playhead, trim it, bring it there; drop a marker; snap every edge. A video is cut in its file.' },
  { Icon: BezierCurve, title: 'Curves', text: 'A graph editor to shape every ease, saved once and reused across the film.' },
  { Icon: Sliders, title: 'An inspector for each layer', text: 'Every setting of the selected layer, ready to animate, and the speech of a video, transcribed when you ask.' },
];
const alt = 'The Tramme atelier: the layers of the Showreel example on the left, the frame in the viewport, the timeline below and the inspector on the right.';
---

<section class="section" id="editor">
  <div class="wrap">
    <Head title="The atelier, for the detail." more="One switch away: the layers, the timeline, the curves and the inspector, on the same film." />
  </div>
  <div class="wrap-wide body">
    <Shot light={light} dark={dark} alt={alt} />
    <Cards items={ITEMS} />
  </div>
</section>

<style>
  .body { margin-top: clamp(40px, 5vw, 64px); }
</style>
