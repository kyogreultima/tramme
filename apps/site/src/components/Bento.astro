---
import Head from './Head.astro';
import { pathIn, t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const items = ['devices', 'visibility', 'export'];
---
<section class="platform wrap" id="platform">
  <span class="section-label">{t(locale, 'nav.cloud')}</span>
  <Head title={t(locale, 'landing.platform.title')} more={t(locale, 'landing.platform.more')} />
  <ul class="details" role="list">
    {items.map((id) => <li><h3>{t(locale, `landing.platform.${id}.title`)}</h3><p>{t(locale, `landing.platform.${id}.text`)}</p><a href={pathIn(locale, '/features/#cloud')}>{t(locale, 'landing.pillars.learn')}</a></li>)}
  </ul>
</section>
<style>
  .platform { padding-top: 28px; padding-bottom: var(--section); border-top: 1px solid var(--line); }
  .section-label { display: block; margin-bottom: 32px; font-size: 0.6875rem; color: var(--ink-2); }
  .platform :global(.head p) { max-width: 42ch; }
  .details { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; list-style: none; margin: 32px 0 0; padding: 0; }
  h3 { font-size: 0.9375rem; line-height: 1.3; }
  .details p { max-width: 38ch; margin-top: 12px; font-size: 0.8125rem; color: var(--ink-2); }
  .details a { display: inline-block; margin-top: 18px; color: var(--ink-2); font-size: 0.6875rem; text-underline-offset: 4px; }
  @media (max-width: 600px) { .details { grid-template-columns: 1fr; gap: 28px; } }
</style>
