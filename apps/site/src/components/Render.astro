---
import Head from './Head.astro';
import { FORMATS } from '../lib/formats';
import { docHref } from '../lib/docs';
import { pick, type Locale, type Localised } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

const COPY: Localised<{ title: string; more: string; cli: string; docs: string }> = {
  en: {
    title: 'What you see is what you export.',
    more: 'The preview and the export are drawn by the same engine, frame for frame.',
    cli: 'Batch renders from a terminal too, for studios that automate:',
    docs: 'see the docs',
  },
  fr: {
    title: 'Ce que vous voyez est ce que vous exportez.',
    more: 'L\'aperçu et l\'export sont dessinés par le même moteur, image par image.',
    cli: 'Des rendus par lots depuis un terminal aussi, pour les studios qui automatisent :',
    docs: 'voir la documentation',
  },
};
const c = pick(locale, COPY);
---

<section class="section" id="render">
  <div class="wrap">
    <Head title={c.title} more={c.more} />
    <ul class="formats" role="list" data-reveal>
      {FORMATS.map(({ name, what }) => (
        <li class="surface"><strong>{name}</strong><span>{pick(locale, what)}</span></li>
      ))}
    </ul>
    <p class="cli" data-reveal>{c.cli} <a href={docHref('')}>{c.docs}</a>.</p>
  </div>
</section>

<style>
  .formats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); margin: 0; padding: 0; list-style: none; }
  li { display: grid; align-content: space-between; gap: 16px; min-height: clamp(128px, 12vw, 176px); padding: clamp(18px, 2.2vw, 28px); }
  strong { font-size: clamp(1.5rem, 2.6vw, 2.25rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.1; }
  span { font-size: 0.875rem; color: var(--ink-3); }
  .cli { margin-top: 20px; font-size: 0.9375rem; color: var(--ink-3); }
  .cli a { color: var(--accent-text); text-underline-offset: 3px; }
  @media (max-width: 820px) { .formats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
