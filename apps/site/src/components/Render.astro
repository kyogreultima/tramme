---
// The export: one shot playing, the files it leaves as. A picture or a video
// format shows that same frame, the sound its waveform: the preview and the
// export are drawn by the same engine.
import { Image } from 'astro:assets';
import Head from './Head.astro';
import Media from './Media.astro';
import VectorFrame from './VectorFrame.astro';
import { proofOf } from '../lib/proofs';
import { FORMATS } from '../lib/formats';
import { docHref } from '../lib/docs';
import { pick, type Locale, type Localised } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

const COPY: Localised<{ title: string; more: string; cli: string; docs: string; shot: string }> = {
  en: {
    title: 'What you see is what you export.',
    more: 'The preview and the export are drawn by the same engine, frame for frame.',
    cli: 'Batch renders from a terminal too, for studios that automate:',
    docs: 'see the docs',
    shot: 'A still photo of a lake moving in 2.5D, the shot every format below is written from.',
  },
  fr: {
    title: 'Ce que vous voyez est ce que vous exportez.',
    more: 'L\'aperçu et l\'export sont dessinés par le même moteur, image par image.',
    cli: 'Des rendus par lots depuis un terminal aussi, pour les studios qui automatisent :',
    docs: 'voir la documentation',
    shot: 'Une photo de lac qui bouge en 2,5D, le plan dont chaque format ci-dessous est écrit.',
  },
};
const c = pick(locale, COPY);
// what each format holds: the frame (a picture or a video), the sound, or the frame as vectors (still, or moving)
const FRAME = new Set(['MP4', 'MOV', 'WebM', 'GIF', 'PNG']);
const frame = proofOf('depth').after;
const WAVE = Array.from({ length: 24 }, (_, i) => 0.3 + 0.7 * Math.abs(Math.sin(i * 0.9) * Math.cos(i * 0.31)));
---

<section class="section" id="render">
  <div class="wrap">
    <Head title={c.title} more={c.more} />
    <div class="export">
      <Media id="proof-depth" width={1920} height={1080} label={c.shot} class="shot" />
      <ul class="formats" role="list" data-stagger>
        {FORMATS.map(({ name, what }) => (
          <li class="surface">
            <strong>{name}</strong>
            <span>{pick(locale, what)}</span>
            {FRAME.has(name) && <Image class="frame" src={frame} alt="" width={128} loading="lazy" />}
            {(name === 'SVG' || name === 'Lottie') && <VectorFrame class="frame" moving={name === 'Lottie'} />}
            {name === 'WAV' && <svg class="wave" viewBox="0 0 24 10" aria-hidden="true">{WAVE.map((h, i) => <rect x={i + 0.2} y={5 - h * 4.5} width="0.6" height={h * 9} />)}</svg>}
          </li>
        ))}
      </ul>
    </div>
    <p class="cli" data-reveal>{c.cli} <a href={docHref('')}>{c.docs}</a>.</p>
  </div>
</section>

<style>
  /* the shot on the left, its files on the right; the shot above them on a narrow screen */
  .export { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 6fr); gap: var(--gap); align-items: start; }
  .export :global(.shot) { --r: var(--r-lg); }
  @media (max-width: 1000px) { .export { grid-template-columns: minmax(0, 1fr); } }
  .formats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  li { position: relative; display: grid; align-content: start; gap: 6px; padding: 14px 16px; }
  /* the same frame, small, in the corner of a format that holds it */
  li :global(.frame) { position: absolute; top: 12px; right: 12px; width: 56px; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 5px; overflow: hidden; }
  .wave { position: absolute; top: 14px; right: 12px; width: 56px; height: 24px; fill: var(--accent-text); }
  strong { font-size: clamp(1.375rem, 2vw, 1.875rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1.1; }
  span { font-size: 0.875rem; color: var(--ink-3); }
  .cli { margin-top: 20px; font-size: 0.9375rem; color: var(--ink-3); }
  .cli a { color: var(--accent-text); text-underline-offset: 3px; }
  @media (max-width: 420px) { li :global(.frame), .wave { display: none; } }
</style>
