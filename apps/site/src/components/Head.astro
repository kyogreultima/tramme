---
// A section's heading, the same everywhere: a title, centred, and one sentence
// under it. The space below it is the section's, so what follows never sets its own.
interface Props { title: string; more?: string }
const { title, more } = Astro.props;
---

<header class="head" data-reveal>
  <h2>{title}</h2>
  {more && <p>{more}</p>}
</header>

<style>
  .head { display: grid; justify-items: center; gap: 14px; margin-bottom: clamp(32px, 4vw, 56px); text-align: center; }
  h2 { max-width: 22ch; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.05; letter-spacing: -0.04em; }
  p { max-width: 36rem; font-size: 1.125rem; line-height: 1.55; color: var(--ink-2); }
</style>
