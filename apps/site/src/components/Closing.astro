---
// The last word before the footer: the way in, once more
import Head from './Head.astro';
import AppLink from './AppLink.astro';
import DownloadLink from './DownloadLink.astro';
---

<section class="section" aria-label="Get started">
  <div class="wrap">
    <div class="band surface">
      <Head title="Your next film starts with a sentence." more="Open the app in your browser, nothing to install. Or take the desktop app, it works offline." />
      <div class="ctas">
        <AppLink />
        <DownloadLink />
      </div>
    </div>
  </div>
</section>

<style>
  .band { padding: clamp(48px, 7vw, 96px) clamp(20px, 5vw, 72px); }
  .band :global(.head) { margin-bottom: 28px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
</style>
