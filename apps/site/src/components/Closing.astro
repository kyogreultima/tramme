---
import { Image } from 'astro:assets';
import ArrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg';
import textile from '../assets/hero-textile.png';
import { signUp } from '../lib/links';
import { pathIn, t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="closing" aria-label={t(locale, 'landing.closing.label')}>
  <div class="wrap">
    <h2>{t(locale, 'landing.closing.title')}</h2>
    <a class="btn btn-accent" href={signUp({ lang: locale })} target="_blank" rel="noopener">{t(locale, 'common.startFree')}<ArrowRight aria-hidden="true" /></a>
    <p>{t(locale, 'landing.closing.basic')} <a href={pathIn(locale, '/pricing/')}>{t(locale, 'landing.closing.plans')}</a></p>
    <div class="lens"><Image src={textile} alt="" widths={[640, 1280]} sizes="(max-width: 800px) 90vw, 70vw" loading="lazy" /></div>
  </div>
</section>
<style>
  .closing { padding-block: clamp(72px, 10vw, 144px) 0; text-align: center; }
  h2 { max-width: 17ch; margin-inline: auto; font-size: clamp(2.5rem, 4.9vw, 5rem); }
  .closing .btn { margin-top: 28px; }
  p { margin-top: 20px; font-size: 0.75rem; color: var(--ink-3); }
  p a { color: var(--ink-2); text-underline-offset: 4px; }
  .lens { width: 78%; aspect-ratio: 3.2; margin: 64px auto 0; border-radius: 50%; overflow: hidden; mask-image: radial-gradient(ellipse closest-side, black 55%, transparent 100%); }
  .lens :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 560px) { .lens { width: 100%; margin-top: 48px; aspect-ratio: 2.5; } }
</style>
