---
// The last word before the footer, over a still of a film made with Tramme:
// the way in, once more. The still is lazy and drifts slowly as the page
// scrolls past it.
import { Image } from 'astro:assets';
import AppLink from './AppLink.astro';
import DownloadLink from './DownloadLink.astro';
import still from '../videos/anime.webp';
---

<section class="section" aria-label="Get started">
  <div class="wrap-wide">
    <div class="band" data-reveal>
      <Image class="still" src={still} alt="" widths={[800, 1440, 2048]} sizes="(max-width: 1440px) 100vw, 1440px" loading="lazy" decoding="async" />
      <div class="words">
        <h2>Your next film starts with a sentence.</h2>
        <p>Open the app in your browser, nothing to install. Or take the desktop app, it works offline.</p>
        <div class="ctas">
          <AppLink />
          <DownloadLink />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .band { position: relative; overflow: hidden; display: grid; place-items: center; min-height: clamp(420px, 52vw, 640px); border-radius: var(--r-lg); background: var(--stage); isolation: isolate; }
  .band :global(.still) { position: absolute; inset: -8% 0; z-index: -2; width: 100%; height: 116%; object-fit: cover; }
  .band::after { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--scrim); }
  .words { display: grid; justify-items: center; gap: 18px; padding: clamp(40px, 6vw, 80px) clamp(20px, 5vw, 72px); text-align: center; color: var(--on-media); }
  h2 { max-width: 16ch; font-size: clamp(2.25rem, 5vw, 4.25rem); letter-spacing: -0.045em; }
  p { max-width: 34rem; font-size: 1.0625rem; opacity: 0.82; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 8px; }
  /* the ghost buttons read on the picture */
  .ctas :global(.btn-ghost) { color: var(--on-media); border-color: color-mix(in srgb, var(--on-media) 35%, transparent); }
  .ctas :global(.btn-ghost:hover) { background: color-mix(in srgb, var(--on-media) 12%, transparent); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .band :global(.still) { animation-name: pan; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 0% exit 100%; }
    }
  }
  @keyframes pan { from { translate: 0 -6%; scale: 1.08; } to { translate: 0 6%; scale: 1; } }
</style>
