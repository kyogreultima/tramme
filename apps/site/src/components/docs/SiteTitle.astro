---
// The docs' title, the landing page's brand (Brand.astro), in place of
// Starlight's logo image
import Brand from '../Brand.astro';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="docs-brand">
  <a href="/" class="site-title" aria-label="Tramme, home"><Brand /></a>
  <a href={siteTitleHref} class="docs-label">Docs</a>
</div>
