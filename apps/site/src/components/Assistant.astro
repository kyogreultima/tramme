---
import Scissors from '@phosphor-icons/core/assets/regular/scissors.svg';
import Waveform from '@phosphor-icons/core/assets/regular/waveform.svg';
import PuzzlePiece from '@phosphor-icons/core/assets/regular/puzzle-piece.svg';
import HandPalm from '@phosphor-icons/core/assets/regular/hand-palm.svg';
import Head from './Head.astro';
import Media from './Media.astro';
import Cards from './Cards.astro';

const ITEMS = [
  { Icon: Scissors, title: 'Dresses a video', text: "Once you transcribe it: cuts the silences and the hesitations, then adds captions, keywords and titles in the project's colours." },
  { Icon: Waveform, title: 'Sound on the cut', text: 'Cleans the voice, places whooshes and hits on the cuts and the entrances, and fits the music under it.' },
  { Icon: PuzzlePiece, title: 'Builds what is missing', text: 'Needs an effect or a layer that does not exist yet? It makes one for your project.' },
  { Icon: HandPalm, title: 'Asks first', text: 'A transcription or anything that costs money waits for your yes. Works with Claude or the model of your choice.' },
];
---

<section class="section" id="assistant">
  <div class="wrap">
    <Head title="The AI edits with your tools." more="It looks at your frames, checks its own work, then shows you a take to keep or set aside." />
    <div class="grid">
      <div class="frame" data-reveal>
        <Media id="assistant" width={1600} height={1000} tint={['#090f13', '#2ec4b6']} label="The assistant proposing a change in the Tramme editor, previewed before it is applied." />
      </div>
      <Cards items={ITEMS} columns={2} />
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 6fr); gap: var(--gap); align-items: stretch; }
  .grid :global(.cards) { margin: 0; }
  .frame { display: grid; align-items: center; padding: clamp(12px, 1.6vw, 20px); border-radius: var(--r-lg); background: var(--stage); }
  @media (max-width: 1100px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
