---
// The site's language, chosen in the footer: two links to the same page in
// each language, so it needs no script. The URL is the language; nothing
// redirects by the browser's language.
import { LOCALES, localeOf, pathFor, t } from '../lib/i18n';

const locale = localeOf(Astro.url.pathname);
---

<nav class="choice" aria-label={t(locale, 'footer.language')}>
  {LOCALES.map((l) => (
    <a href={pathFor(l, Astro.url.pathname)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>{t(l, `common.${l === 'fr' ? 'french' : 'english'}`)}</a>
  ))}
</nav>

<style>
  .choice { display: inline-flex; padding: 3px; border: 1px solid var(--line-2); border-radius: var(--tramme-radius-control); }
  a {
    padding: 5px 14px; border-radius: var(--tramme-radius-control); color: var(--ink-3); font-size: 0.875rem; text-decoration: none;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  a:hover { color: var(--ink); }
  a[aria-current] { background: var(--hover); color: var(--ink); }
</style>
