---
import { Image } from 'astro:assets';
import ArrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg';
import hero from '../assets/hero-textile.png';
import { signUp } from '../lib/links';
import { FEATURES, wordsOf } from '../lib/features';
import { pathIn, t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title" data-wave-hero>
  <Image class="texture" src={hero} alt="" widths={[640, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
  <canvas class="wave" data-wave aria-hidden="true"></canvas>
  <div class="bleed content">
    <h1 id="hero-title">{t(locale, 'landing.hero.title')}<br /><span>{t(locale, 'landing.hero.quiet')}</span></h1>
    <div class="lower">
      <p>{t(locale, 'landing.hero.more')}</p>
      <div class="actions">
        <a class="btn btn-accent" href={signUp({ lang: locale })} target="_blank" rel="noopener">{t(locale, 'common.startFree')}<ArrowRight aria-hidden="true" /></a>
        {/* paused until Tramme's own visuals are good enough: reopen by restoring this block (it leads to the film section)
        <a class="btn btn-ghost" href="#film">{t(locale, 'landing.hero.watch')}</a>
        */}
      </div>
    </div>
  </div>
  <nav class="film-tools" aria-label={t(locale, 'landing.pillars.label')}>
    <div class="bleed tools">{FEATURES.map((f) => <a href={pathIn(locale, `/features/#${f.id}`)}>{wordsOf(f, locale).name}</a>)}</div>
  </nav>
</section>

<script>
  import { setupHeroWave } from '../lib/hero-wave';
  // at each page (the router loads this script once): the wave of the hero, stopped when the page is left
  document.addEventListener('astro:page-load', () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-wave-hero]')) {
      const cleanup = setupHeroWave(root);
      document.addEventListener('astro:before-swap', cleanup, { once: true });
    }
  });
</script>

<style>
  .hero { --bg: var(--tramme-dark-bg); --ink: var(--tramme-dark-text); --line-2: var(--tramme-dark-line-strong); --accent: var(--tramme-dark-accent); --accent-2: var(--tramme-dark-accent-hover); --accent-ink: var(--tramme-dark-on-accent); --accent-text: var(--tramme-dark-accent-text); --hover: var(--tramme-dark-hover); color-scheme: dark; }
  .hero { position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: flex-end; min-height: min(820px, 94svh); padding-top: 160px; background: var(--bg); color: var(--ink); }
  .texture { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .wave { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; pointer-events: none; opacity: 0; transition: opacity 800ms ease-out; }
  .hero[data-wave-ready] .wave { opacity: 1; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, transparent 20%, var(--hero-shade) 100%); }
  .content { display: grid; grid-template-columns: 1.65fr 1fr; align-items: end; gap: 32px; padding-block: 100px 52px; }
  h1 { max-width: 19ch; font-size: clamp(3.2rem, 6.9vw, 7.5rem); line-height: 1.02; text-wrap: initial; }
  h1 span { color: var(--hero-muted); }
  .lower { max-width: 27rem; padding-bottom: 5px; }
  .lower p { max-width: 37ch; font-size: clamp(0.9375rem, 1.15vw, 1.0625rem); line-height: 1.5; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .film-tools { background: var(--hero-strip); border-top: 1px solid var(--line-2); }
  .tools { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 78px; }
  .tools a { font-size: clamp(0.875rem, 1.4vw, 1.25rem); font-weight: 500; text-decoration: none; }
  .tools a:hover { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 960px) {
    .content { grid-template-columns: 1fr; gap: 28px; padding-top: 120px; }
    h1 { font-size: clamp(3.4rem, 8.8vw, 6.5rem); }
  }
  @media (max-width: 560px) {
    .hero { min-height: 94svh; padding-top: 140px; }
    .content { padding-block: 80px 36px; }
    h1 { font-size: clamp(2.6rem, 9.5vw, 3.8rem); }
    .lower p { font-size: 0.875rem; }
    .tools { flex-wrap: wrap; justify-content: flex-start; gap: 14px 25px; padding-block: 18px; min-height: 70px; }
    .tools a { font-size: 0.875rem; }
    .texture { object-position: 42% center; }
  }
</style>
