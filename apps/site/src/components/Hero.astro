---
import Media from './Media.astro';
import AppLink from './AppLink.astro';
import DownloadLink from './DownloadLink.astro';
import { docHref } from '../lib/docs';
import { version } from '../../package.json';

const about = 'The editor at work: a film directed in words, and every layer of it in the atelier.';
const minor = version.split('.').slice(0, 2).join('.');
---

<section class="hero">
  <div class="wrap top">
    <a class="news" href="#studio"><i aria-hidden="true"></i>New in {minor}: the studio</a>
    <h1>Motion design, <span class="quiet">directed in words.</span></h1>
    <p>Leave notes on the film, keep the takes you like, refine every keyframe in the atelier. Free and open source.</p>
    <div class="ctas">
      <AppLink />
      <DownloadLink />
      <a class="btn btn-ghost" href={docHref('')}>Read the docs</a>
    </div>
  </div>

  <div class="wrap-wide stage">
    <Media id="tramme" width={1920} height={1080} duration={10} tint={['#0b0f12', '#2ec4b6']} label={`Tramme. ${about}`} />
    <p class="caption"><strong>Tramme.</strong> {about}</p>
  </div>
</section>

<style>
  .hero { padding-top: clamp(40px, 6vw, 80px); }
  .top { display: flex; flex-direction: column; align-items: center; gap: 22px; text-align: center; }
  h1 { font-size: clamp(2.75rem, 6.4vw, 5.75rem); line-height: 0.98; letter-spacing: -0.048em; }
  h1 .quiet { display: block; }
  .top > p { max-width: 34rem; font-size: 1.1875rem; line-height: 1.55; color: var(--ink-2); }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 6px; }
  .news {
    display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 14px 0 10px; border-radius: 999px;
    background: var(--panel); box-shadow: inset 0 0 0 1px var(--line); color: var(--ink-2); font-size: 0.8125rem; text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .news:hover { color: var(--ink); }
  .news i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .quiet { color: var(--ink-3); }

  .stage { position: relative; margin-top: clamp(48px, 6.5vw, 88px); perspective: 1800px; }
  .stage :global(.media) { box-shadow: var(--lift); border-radius: var(--r-lg); }
  .caption { margin-top: 16px; }

  @media (prefers-reduced-motion: no-preference) {
    .news, h1, .top > p, .ctas, .stage { animation: enter 0.9s var(--ease) both; }
    h1 { animation-delay: 60ms; }
    .top > p, .ctas { animation-delay: 140ms; }
    .stage { animation-delay: 240ms; }
  }
  @keyframes enter { from { opacity: 0; transform: translateY(20px); } }
  /* the film comes in tilted back and lies flat as the page scrolls */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .stage :global(.media) { transform-origin: 50% 0%; animation-name: flatten; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root); animation-range: 0 60vh; }
    }
  }
  @keyframes flatten { from { transform: rotateX(24deg) scale(0.9); } }

</style>
