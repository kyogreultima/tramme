---
import Media from './Media.astro';
import AppLink from './AppLink.astro';
import DownloadLink from './DownloadLink.astro';
import { docHref } from '../lib/docs';

const about = 'The editor at work: a film directed in words, and every layer of it in the atelier.';
---

<section class="hero">
  <div class="wrap top">
    <h1 class="display">Motion design, <span class="quiet">directed in words.</span></h1>
    <p>Leave notes on the film, keep the takes you like, refine every keyframe in the atelier. Free to use, no account.</p>
    <div class="ctas">
      <AppLink />
      <DownloadLink />
      <a class="btn btn-ghost" href={docHref('')}>Read the docs</a>
    </div>
  </div>

  <div class="wrap stage">
    <Media id="tramme" width={1920} height={1080} duration={10} tint={['#0b0f12', '#2ec4b6']} label={`Tramme. ${about}`} />
  </div>
</section>

<style>
  .hero { padding-top: clamp(40px, 6vw, 80px); }
  .top { display: flex; flex-direction: column; align-items: center; gap: 22px; text-align: center; }
  h1 { max-width: 14ch; }
  h1 .quiet { display: block; color: var(--ink-3); }
  .top > p { max-width: 34rem; font-size: 1.1875rem; line-height: 1.55; color: var(--ink-2); }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 6px; }

  .stage { margin-top: clamp(40px, 5vw, 72px); }
  .stage :global(.media) { box-shadow: var(--lift); border-radius: var(--r-lg); }

  @media (prefers-reduced-motion: no-preference) {
    h1, .top > p, .ctas, .stage { animation: enter 0.9s var(--ease) both; }
    .top > p, .ctas { animation-delay: 100ms; }
    .stage { animation-delay: 200ms; }
  }
  @keyframes enter { from { opacity: 0; transform: translateY(20px); } }
</style>
