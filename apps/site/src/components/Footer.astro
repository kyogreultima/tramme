---
import LanguageChoice from './LanguageChoice.astro';
import ThemeChoice from './ThemeChoice.astro';
import { footerColumns } from '../lib/nav';
import { localeOf, t } from '../lib/i18n';

const locale = localeOf(Astro.url.pathname);
---

<footer class="foot">
  <div class="wrap">
    <nav class="cols" aria-label={t(locale, 'footer.label')}>
      {footerColumns(locale).map((menu) => (
        <section>
          <strong>{menu.label}</strong>
          <ul role="list">{menu.links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
        </section>
      ))}
    </nav>
    <div class="bottom">
      <p class="legal">{t(locale, 'footer.copyright')}</p>
      <div class="choices">
        <LanguageChoice />
        <ThemeChoice />
      </div>
    </div>
  </div>
</footer>

<style>
  .foot { margin-top: var(--section); padding-block: clamp(40px, 5vw, 64px) 40px; border-top: 1px solid var(--line); }
  .cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px var(--gutter); }
  strong { display: block; margin-bottom: 14px; font-size: 0.875rem; font-weight: 500; color: var(--ink); }
  ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  a { font-size: 0.9375rem; color: var(--ink-3); text-decoration: none; transition: color 0.2s var(--ease); }
  a:hover { color: var(--ink); }
  .bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; margin-top: clamp(40px, 5vw, 64px); }
  .legal { font-size: 0.875rem; color: var(--ink-3); }
  .choices { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 820px) { .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
