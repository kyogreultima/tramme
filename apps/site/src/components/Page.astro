---
// A page of the site: the head, the top bar, the page itself, the footer. The
// language is the address's (lib/i18n.ts); a page puts its structured data in
// the "head" slot.
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { localeOf, t } from '../lib/i18n';

interface Props { title: string; description: string; landing?: boolean }
const { title, description, landing = false } = Astro.props;
---

<Base title={title} description={description} landing={landing}>
  <slot name="head" slot="head" />
  <a class="skip" href="#content">{t(localeOf(Astro.url.pathname), 'common.skip')}</a>
  <Nav />
  <main id="content" tabindex="-1">
    <slot />
  </main>
  <Footer landing={landing} />
</Base>
