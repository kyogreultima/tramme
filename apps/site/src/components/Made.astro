---
import Head from './Head.astro';
import ExampleTile from './ExampleTile.astro';
import { IDS } from '../lib/examples';

// the examples: the first across the page, then the others side by side
---

<section class="section" id="made">
  <div class="wrap">
    <Head title="Made with Tramme." more="Every example is in the repository, ready to open and take apart." />
    <div class="grid">
      {IDS.map((id, i) => <div class:list={['cell', { wide: i === 0 }]}><ExampleTile id={id} /></div>)}
    </div>
    <p class="all"><a href="/examples/">See every example</a></p>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 48px 20px; margin-top: clamp(40px, 5vw, 64px); }
  .cell { grid-column: span 6; }
  .wide { grid-column: span 12; }
  .all { margin-top: 32px; font-size: 0.9375rem; }
  .all a { color: var(--accent-text); text-underline-offset: 3px; }

  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .cell, .wide { grid-column: auto; }
  }
</style>
