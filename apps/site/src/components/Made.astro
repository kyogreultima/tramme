---
// The examples, three in a row: each a video slot and a line, and the way to the rest
import Head from './Head.astro';
import ExampleTile from './ExampleTile.astro';
import { IDS } from '../lib/examples';
---

<section class="section" id="made">
  <div class="wrap">
    <Head title="Made with Tramme." more="Every example is in the repository, ready to open and take apart." />
    <div class="grid">
      {IDS.map((id) => <ExampleTile id={id} />)}
    </div>
    <p class="all"><a class="btn btn-ghost" href="/examples/">See every example</a></p>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 20px; }
  .all { display: flex; justify-content: center; margin-top: 36px; }
  @media (max-width: 960px) { .grid { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
</style>
