---
// The questions people ask first (lib/faq.ts), one <details> each: they open
// and close without script, and the page tells the search engines the same
// questions (lib/site.ts).
import Head from './Head.astro';
import { FAQ } from '../lib/faq';
---

<section class="section" id="faq">
  <div class="wrap">
    <Head title="Questions, answered." more="The things people ask before they start." />
    <div class="list" data-reveal>
      {FAQ.map(({ q, a }) => (
        <details class="surface">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .list { display: grid; gap: var(--gap); max-width: 52rem; margin: 0 auto; }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 20px clamp(20px, 2.4vw, 28px);
    list-style: none; cursor: pointer; font-size: 1.0625rem; font-weight: 500; letter-spacing: -0.015em;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ''; flex: none; width: 8px; height: 8px; margin-top: -4px; border: solid var(--ink-3); border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); transition: transform 0.2s var(--ease); }
  [open] > summary::after { margin-top: 4px; transform: rotate(-135deg); }
  p { padding: 0 clamp(20px, 2.4vw, 28px) 22px; max-width: 44rem; font-size: 0.9688rem; line-height: 1.6; color: var(--ink-2); }
</style>
