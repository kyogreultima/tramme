---
import { BUILTIN_MODIFIERS } from '@tramme/core';
import { EFFECTS, NODES } from '@tramme/nodes';
import Copy from '@phosphor-icons/core/assets/regular/copy.svg';
import Check from '@phosphor-icons/core/assets/regular/check.svg';
import Head from './Head.astro';
import DownloadLink from './DownloadLink.astro';
import RepoLink from './RepoLink.astro';
import { FORMATS } from '../lib/formats';
import { REPO } from '../lib/links';
import { localeOf, t } from '../lib/i18n';
const locale = localeOf(Astro.url.pathname);

// counted from the code, at build time
const release = __RELEASE__;
const LANGUAGES = Object.keys(import.meta.glob('../../../editor/src/i18n/*.json')).length;
const STATS: [number, string][] = [
  [NODES.length, t(locale, 'source.layers')],
  [EFFECTS.length, t(locale, 'source.effects')],
  [BUILTIN_MODIFIERS.length, t(locale, 'source.modifiers')],
  [FORMATS.length, t(locale, 'source.formats')],
  [LANGUAGES, t(locale, 'source.languages')],
  // the systems of the latest release, left out without one
  ...(release ? [[new Set(release.installers.map((i) => i.os)).size, t(locale, 'source.systems')] as [number, string]] : []),
];
const CLONE = `git clone ${REPO}`;
---

<section class="section" id="source">
  <div class="wrap">
    <div class="panel surface">
      <Head title={t(locale, 'source.title')} more={t(locale, 'source.more')} />
      <dl class="stats" data-reveal>
        {STATS.map(([n, label]) => (
          <div><dt>{label}</dt><dd>{n}</dd></div>
        ))}
      </dl>
      <div class="actions" data-reveal>
        <div class="clone">
          <code>{CLONE}</code>
          <button type="button" class="copy" data-copy={CLONE} data-copy-label={t(locale, 'source.copy')} data-copied-label={t(locale, 'source.copied')} data-failed-label={t(locale, 'source.failed')} aria-label={t(locale, 'source.copy')}>
            <Copy class="i-copy" aria-hidden="true" />
            <Check class="i-check" aria-hidden="true" />
          </button>
        </div>
        <RepoLink />
        <DownloadLink />
      </div>
    </div>
  </div>
</section>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.dataset.done = '';
        b.setAttribute('aria-label', b.dataset.copiedLabel!);
        setTimeout(() => { delete b.dataset.done; b.setAttribute('aria-label', b.dataset.copyLabel!); }, 1600);
      } catch {
        b.setAttribute('aria-label', b.dataset.failedLabel!);
      }
    });
  }
</script>

<style>
  .panel {
    padding: clamp(48px, 7vw, 104px) clamp(20px, 5vw, 72px);
    border-radius: var(--r-lg);
  }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 0; max-width: 880px; margin: 0 auto; }
  .stats div { display: flex; flex-direction: column-reverse; align-items: center; gap: 4px; padding: 4px 12px; }
  dd { margin: 0; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1; font-variant-numeric: tabular-nums; }
  dt { font-size: 0.875rem; color: var(--ink-3); }

  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: clamp(40px, 5vw, 56px); }
  .clone { display: flex; align-items: center; gap: 12px; height: 44px; min-width: 0; max-width: 100%; padding: 0 6px 0 18px; border: 1px solid var(--line-2); border-radius: var(--tramme-radius-control); background: var(--bg); }
  .clone code { overflow: hidden; font-size: 0.8125rem; color: var(--ink-2); white-space: nowrap; text-overflow: ellipsis; }
  .copy { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: var(--tramme-radius-control); background: transparent; color: var(--ink-3); cursor: pointer; }
  .copy:hover { background: var(--hover); color: var(--ink); }
  .copy svg { width: 16px; height: 16px; }
  .i-check, [data-done] .i-copy { display: none; }
  [data-done] .i-check { display: block; color: var(--accent-text); }

  @media (max-width: 720px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 28px; }
  }
</style>
