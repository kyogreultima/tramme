---
// Light or dark, chosen in the footer: two options only, because the
// site is light first even for a visitor whose computer is dark. The choice is
// kept under Starlight's 'starlight-theme' key (read by ThemeProvider.astro),
// so it holds in the docs too. The only script of the footer.
import { localeOf, t } from '../lib/i18n';

const locale = localeOf(Astro.url.pathname);
---

<div class="choice" role="group" aria-label={t(locale, 'footer.theme')}>
  <button type="button" data-theme-option="light" aria-pressed="true">{t(locale, 'common.light')}</button>
  <button type="button" data-theme-option="dark" aria-pressed="false">{t(locale, 'common.dark')}</button>
</div>

<script>
  const root = document.documentElement;
  const options = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');
  const show = (theme: string) => {
    root.dataset.theme = theme;
    for (const o of options) o.setAttribute('aria-pressed', String(o.dataset.themeOption === theme));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(document.body).backgroundColor);
  };
  for (const o of options) o.addEventListener('click', () => {
    const next = o.dataset.themeOption!;
    show(next);
    try { localStorage.setItem('starlight-theme', next); } catch { /* remembered for this page only */ }
  });
  show(root.dataset.theme === 'dark' ? 'dark' : 'light');
</script>

<style>
  .choice { display: inline-flex; padding: 3px; border: 1px solid var(--line-2); border-radius: 999px; }
  button {
    padding: 5px 14px; border: 0; border-radius: 999px; background: transparent; color: var(--ink-3); font: inherit; font-size: 0.875rem; cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  button:hover { color: var(--ink); }
  button[aria-pressed='true'] { background: var(--hover); color: var(--ink); }
</style>
