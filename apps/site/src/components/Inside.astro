---
// Animation, in a motion designer's words: keys and curves, the usual
// behaviours one click away, properties that follow others, a style named
// once. The file format is a link for those who want it, never the pitch.
import BezierCurve from '@phosphor-icons/core/assets/regular/bezier-curve.svg';
import Waves from '@phosphor-icons/core/assets/regular/wave-sine.svg';
import LinkSimple from '@phosphor-icons/core/assets/regular/link-simple.svg';
import Palette from '@phosphor-icons/core/assets/regular/palette.svg';
import Head from './Head.astro';
import Cards from './Cards.astro';
import { docHref } from '../lib/docs';

const ITEMS = [
  { Icon: BezierCurve, title: 'Keyframes and curves', text: 'Set a key, shape its ease in the graph editor, nudge it on the timeline. The way you already animate.' },
  { Icon: Waves, title: 'Wiggle, loop, spring', text: 'The usual behaviours sit on any property, one click away: wiggle, loop, spring, stagger, react to the beat.' },
  { Icon: LinkSimple, title: 'Properties that follow', text: 'Tie a property to another layer, or write a small expression if you like that. Never required.' },
  { Icon: Palette, title: 'A style named once', text: 'Colours, eases and sizes kept as a palette: change one, the whole film follows.' },
];
---

<section class="section" id="inside">
  <div class="wrap">
    <Head title="Everything can move." more="With the tools you know, and a few you will not want to give up." />
    <div class="body">
      <Cards items={ITEMS} columns={2} />
      <p class="more" data-reveal>Under the hood, a project is a readable file that versions like code. <a href={docHref('document')}>See the format</a>, if you are curious.</p>
    </div>
  </div>
</section>

<style>
  .more { margin-top: 20px; text-align: center; font-size: 0.9375rem; color: var(--ink-3); }
  .more a { color: var(--accent-text); text-underline-offset: 3px; }
</style>
