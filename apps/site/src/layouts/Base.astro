---
// the choice about audience measurement (only asked on the production address)
import Consent from '../components/Consent.astro';
// the visitor's system, for the download buttons
import Platform from '../components/Platform.astro';
import SiteHead from '../components/SiteHead.astro';
import SocialImage from '../components/SocialImage.astro';
import { SITE } from '../lib/site';
import { ground } from '../lib/logo';
import { LOCALES, localeOf, pathFor } from '../lib/i18n';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/site.css';
import '../styles/landing.css';

interface Props { title: string; description: string; landing?: boolean }
const { title, description, landing = false } = Astro.props;
// the page's language, and the same page in each language (hreflang)
const locale = localeOf(Astro.url.pathname);
const alternates = LOCALES.map((l) => ({ l, href: new URL(pathFor(l, Astro.url.pathname), Astro.site).href }));
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const segment = Astro.url.pathname.replace(/^\/fr(?=\/|$)/, '').split('/')[1] || 'home';
const page = segment === 'p' ? 'project' : segment;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={ground} />
    {alternates.map(({ l, href }) => <link rel="alternate" hreflang={l} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <SocialImage />
    <!-- pages change without a reload (Astro's router); the documentation is another layout, with its own scripts: a full load -->
    <ClientRouter />
    <script is:inline>
      // the site is dark only; the router swaps <html>'s attributes at each page, so it is put back after each swap
      const dark = () => { document.documentElement.dataset.theme = 'dark'; };
      dark();
      document.addEventListener('astro:after-swap', dark);
      // a link to the documentation leaves the router (it is not one of its pages)
      document.addEventListener('click', (e) => {
        const a = e.target instanceof Element ? e.target.closest('a[href]') : null;
        if (a && /^(\/fr)?\/docs(\/|$)/.test(new URL(a.href, location.href).pathname)) a.setAttribute('data-astro-reload', '');
      }, true);
    </script>
    <Platform />
    <SiteHead />
    <Font cssVariable="--font-display" preload />
    <slot name="head" />
  </head>
  <body class:list={['site', { landing }]} data-page={page}>
    <slot />
    <Consent />
  </body>
</html>
