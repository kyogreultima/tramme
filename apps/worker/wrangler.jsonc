{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The private deployment (npm run deploy): one user behind Cloudflare Access, projects and keys in R2.
  // The public one is the "personal" environment below (npm run deploy:personal). See docs/deploy.md.
  "name": "tramme-private",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // the editor (npm run build) served as a single-page app; /api goes to the Worker
  "assets": {
    "directory": "../editor/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // the projects (npx wrangler r2 bucket create tramme-projects)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tramme-projects" }],
  // Cloudflare Access protecting the app: team domain (equipe.cloudflareaccess.com)
  // and the application's audience tag (AUD), from the Zero Trust dashboard.
  // The model keys are secrets: npx wrangler secret put ANTHROPIC_API_KEY (and OPENAI_API_KEY,
  // GEMINI_API_KEY, OPENROUTER_API_KEY, ZAI_API_KEY for the other providers, each optional)
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  // speech to text for the assistant (Whisper); used from `wrangler dev` too, through your Cloudflare account
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "env": {
    // Personal mode: anyone uses the app without an account, and nothing is kept on the server.
    // Projects stay in each visitor's browser, keys in the key vault: another origin of the same
    // site (a subdomain), which the editor and its plugins cannot read. No R2, no Access, no Workers AI.
    "personal": {
      "name": "tramme",
      "assets": {
        "directory": "../editor/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // every request: the Worker tells the editor from the vault by their address
        "run_worker_first": true
      },
      // the two addresses, both on the same domain (same site: the vault keeps its storage)
      "vars": {
        "MODE": "personal",
        "APP_ORIGIN": "https://app.tramme.dev",
        "VAULT_ORIGIN": "https://cles.app.tramme.dev"
      },
      // the same two hosts as custom domains of this Worker
      "routes": [
        { "pattern": "app.tramme.dev", "custom_domain": true },
        { "pattern": "cles.app.tramme.dev", "custom_domain": true }
      ],
      // requests a visitor may send through the relay (Z.AI, custom providers), per minute
      "ratelimits": [{ "name": "RELAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
      // the relay passes keys in its requests: no invocation logs (they record the requests)
      "observability": { "enabled": true, "logs": { "invocation_logs": false } },
      // branch builds (npx wrangler preview --env personal) inherit none of the above:
      // the same vars (a preview's own address sends to APP_ORIGIN), limit and logs
      "previews": {
        "vars": {
          "MODE": "personal",
          "APP_ORIGIN": "https://app.tramme.dev",
          "VAULT_ORIGIN": "https://cles.app.tramme.dev"
        },
        "ratelimits": [{ "name": "RELAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
        "observability": { "enabled": true, "logs": { "invocation_logs": false } }
      }
    },
    // Accounts (npm run deploy:cloud): the personal deployment, plus the accounts backend (apps/server) as a
    // container behind this Worker. The backend has no address of its own: the only way to it is the
    // ACCOUNTS binding, which the Worker calls for /api/auth, /api/account and /api/billing (src/accounts.ts).
    // Its settings are the vars below and its secrets, given by `wrangler secret put <NAME> --env cloud`:
    //   APP_KEY (node ace generate:key in apps/server), DATABASE_URL, EDGE_SECRET and INTERNAL_SECRET (each:
    //   openssl rand -hex 32), SMTP_PASSWORD, and, once their applications exist, GOOGLE_CLIENT_SECRET,
    //   GITHUB_CLIENT_SECRET and BILLING_WEBHOOK_SECRET (+ GOOGLE_CLIENT_ID, GITHUB_CLIENT_ID).
    // It has no routes yet: it is deployed beside the personal one. Give it app.tramme.dev (and cles.app.tramme.dev)
    // when it replaces it, and set APP_ORIGIN to the address it is served at. Beta and preprod are copies of this
    // environment, each with its own address, database and secrets (docs/environments.md).
    "cloud": {
      "name": "tramme-cloud",
      "assets": {
        "directory": "../editor/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "vars": {
        "MODE": "personal",
        "APP_ORIGIN": "https://app.tramme.dev",
        "VAULT_ORIGIN": "https://cles.app.tramme.dev",
        "SMTP_HOST": "smtp.mx.cloudflare.net",
        "SMTP_PORT": "465",
        "SMTP_USERNAME": "api_token",
        "MAIL_FROM_NAME": "Tramme",
        "MAIL_FROM_ADDRESS": "no-reply@tramme.dev",
        "BILLING_PROVIDER": "fake"
      },
      "ratelimits": [{ "name": "RELAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
      "observability": { "enabled": true, "logs": { "invocation_logs": false } },
      "containers": [
        {
          "class_name": "AccountsContainer",
          // the image is built from the repository's root: the backend uses the packages beside it
          "image": "../server/Dockerfile",
          "image_build_context": "../..",
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountsContainer" }] },
      "exports": { "AccountsContainer": { "type": "durable-object", "storage": "sqlite" } }
    }
  }
}
