{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The server mode, run by `pnpm dev` (wrangler dev): projects and keys in a simulated R2, the Access check
  // lifted on localhost. It is not deployed: deployed, its API would answer only requests signed by Cloudflare
  // Access (src/access.ts). A deployment without accounts is the "personal" environment below (pnpm deploy:personal).
  // See docs/deploy.md.
  "name": "tramme-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // the editor (pnpm build) served as a single-page app; /api goes to the Worker
  "assets": {
    "directory": "../editor/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/project-sandbox.html", "/project-sandbox"]
  },
  // the projects, simulated in .wrangler/state (the name only names the simulated bucket)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tramme-projects" }],
  // Cloudflare Access: empty, so nothing but localhost (DEV_OPEN) gets through. The model keys, locally,
  // are connected in the settings or go in apps/worker/.dev.vars
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // the export on the server: the renderer started on this machine by `pnpm renderer` (apps/renderer)
    "RENDERER_URL": "http://127.0.0.1:8080"
  },
  // the queue of the exports on the server (renders.ts), one at a time
  "durable_objects": { "bindings": [{ "name": "RENDER_QUEUE", "class_name": "RenderQueue" }] },
  "migrations": [{ "tag": "render-queue", "new_sqlite_classes": ["RenderQueue"] }],
  // speech to text for the assistant (Whisper); used from `wrangler dev` too, through your Cloudflare account
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },
  "env": {
    // Personal mode: anyone uses the app without an account, and nothing is kept on the server.
    // Its addresses are an example to replace with your own domain's (docs/deploy.md): app.tramme.dev is the
    // production deployment with accounts, made by the private platform repository under the Worker name "tramme".
    // Projects stay in each visitor's browser, keys in the key vault: another origin of the same
    // site (a subdomain), which the editor and its plugins cannot read. No R2, no Access, no Workers AI.
    "personal": {
      "name": "tramme-personal",
      "assets": {
        "directory": "../editor/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // every request: the Worker tells the editor from the vault by their address
        "run_worker_first": true
      },
      // the two addresses, both on the same domain (same site: the vault keeps its storage)
      "vars": {
        "MODE": "personal",
        "APP_ORIGIN": "https://tramme.example.com",
        "VAULT_ORIGIN": "https://cles.tramme.example.com"
      },
      // the same two hosts as custom domains of this Worker
      "routes": [
        { "pattern": "tramme.example.com", "custom_domain": true },
        { "pattern": "cles.tramme.example.com", "custom_domain": true }
      ],
      // requests a visitor may send through the relay (Z.AI, custom providers), per minute
      "ratelimits": [{ "name": "RELAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
      // the relay passes keys in its requests: no invocation logs (they record the requests)
      "observability": { "enabled": true, "logs": { "invocation_logs": false } },
      // branch builds (pnpm exec wrangler preview --env personal) inherit none of the above:
      // the same vars (a preview's own address sends to APP_ORIGIN), limit and logs
      "previews": {
        "vars": {
          "MODE": "personal",
          "APP_ORIGIN": "https://tramme.example.com",
          "VAULT_ORIGIN": "https://cles.tramme.example.com"
        },
        "ratelimits": [{ "name": "RELAY_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
        "observability": { "enabled": true, "logs": { "invocation_logs": false } }
      }
    }
    // The accounts deployments (beta and production: this Worker with the accounts backend as a container
    // behind it) are defined and deployed from the private platform repository, which takes this Worker as is.
  }
}
