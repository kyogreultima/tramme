# Model of apps/worker/.dev.vars: copy it to .dev.vars and fill in the keys.
# Never put real keys in this file (it is kept in git).
# Simpler: connect the providers in the editor (Settings, Providers); a key
# connected there comes before the one here.
# Deployed app: the same names as Cloudflare secrets (npx wrangler secret put NAME).

# Claude through the server (fallback when the local companion is not running)
ANTHROPIC_API_KEY=

# Other providers (OpenAI chat format)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=

# Sounds made by a provider (sound effects, music, voice-overs): ElevenLabs makes
# all three; a voice-over can also come from OpenAI or Gemini with the keys above
ELEVENLABS_API_KEY=

# Optional: send pictures (OpenAI gpt-image-1), sound effects, music beds, voice-overs, and
# GET /api/voices through Hydracept instead of the provider keys above (no ELEVENLABS_API_KEY needed).
# MEDIA_PROVIDER=hydracept
# HYDRACEPT_API_KEY=
# HYDRACEPT_PROJECT=          # cpr_… from Hydracept Studio
# HYDRACEPT_PRODUCT_ID=tramme # optional product label
# HYDRACEPT_ENVIRONMENT=development
# HYDRACEPT_BILLING_MODE=managed   # or byok
